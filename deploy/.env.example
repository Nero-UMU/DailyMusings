# Copy to deploy/.env and adjust. Only non-secret deployment knobs belong here — keys and SMTP passwords live in
# deploy/secrets/ and are mounted as Docker secrets (docs §10.4).

# Host port the service is published on. Terminate TLS in front of it if this is reachable from anywhere
# untrusted. 18321 rather than 8080: 8080 is the most contended port on a self-hosted box.
DAILYMUSINGS_HTTP_PORT=18321

# The port the instance listens on *inside* the container. Leave it alone unless you changed the port on the
# admin page's instance settings — if you did, put the same number here and recreate the container
# (`docker compose -f deploy/compose.yaml up -d --force-recreate`), or the published mapping above will point at
# a port nothing is listening on. The admin page prints these exact instructions next to the field.
DAILYMUSINGS_INTERNAL_PORT=18321

# SMTP for notification mail is configured on the admin page (通知管理) — that is the intended place, and it needs
# no redeploy. To configure a relay from the deployment instead, uncomment the Smtp__* block in compose.yaml. The
# two encryption switches are Smtp__Ssl (465, handshake first) and Smtp__StartTls (587, greet then upgrade); never
# both. The names this used to have — Smtp__Security (none|starttls|ssl) and Smtp__UseStartTls — still work.
# The password is a secret file (deploy/secrets/smtp-password), not a variable here.
