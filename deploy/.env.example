# Required absolute host directories for the two bind mounts in compose.yaml.
# Create both directories before starting, then make them writable by uid 1654:
#   sudo mkdir -p /srv/dailymusings/config /srv/dailymusings/data
#   sudo chown -R 1654:1654 /srv/dailymusings/config /srv/dailymusings/data
DAILYMUSINGS_CONFIG_DIR=/srv/dailymusings/config
DAILYMUSINGS_DATA_DIR=/srv/dailymusings/data

# Optional port overrides.
DAILYMUSINGS_HTTP_PORT=18321
DAILYMUSINGS_INTERNAL_PORT=18321

# Optional default for a fresh instance. The model page can replace it with any supported explicit API type.
DAILYMUSINGS_TRANSCRIPTION_API_TYPE=openai_transcription
