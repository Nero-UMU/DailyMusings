@page "/inputs"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IServiceScopeFactory ScopeFactory
@inject ILoggerFactory LoggerFactory
@using DailyMusings.Application.Inputs
@using DailyMusings.Application.Reflections
@using DailyMusings.Domain.Inputs
@using DailyMusings.Domain.Reflections
@using DailyMusings.Domain.Time

@* A read-only window onto what the instance actually holds: the recordings, what the model made of them, and the
   draft for the day. Every other admin page configures or operates; this one exists because an operator who cannot
   see the content has no way to answer "did my recording arrive, and is the transcript right?" without a shell on
   the host. Editing, confirming and publishing stay in the client, which is where §4.1 puts them. *@

<h1>采集</h1>

<p class="hint">
    只读视图。日常的修订、确认与发布请在客户端做；这里用来核对「录进去了没有、转写对不对、当天草稿长什么样」。
</p>

@if (_error is not null)
{
    <p class="notice error">@_error</p>
}

<div class="form-grid">
    <label>
        日期（内容时区）
        <input @bind="_date" placeholder="2026-09-17" />
    </label>
</div>

<div class="actions">
    <button class="btn-primary" @onclick="LoadAsync" disabled="@_busy">读取这一天</button>
    <button @onclick="GoToTodayAsync" disabled="@_busy">回到今天</button>
</div>

<h2>输入 · @_date</h2>

@if (_inputs is null)
{
    <p class="muted">正在读取…</p>
}
else if (_inputs.Count == 0)
{
    <p class="notice info">这一天没有任何输入。</p>
}
else
{
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>拍摄时间</th>
                    <th>类型</th>
                    <th>状态</th>
                    <th>内容</th>
                    <th>音频</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in _inputs)
                {
                    <tr>
                        <td class="nowrap">
                            @DeviceLocalTime(item.Entry)
                            <div class="hint">@item.Entry.CreatedAtUtc.ToString("HH:mm:ss") UTC</div>
                        </td>
                        <td>@(item.Entry.SourceType == InputSourceType.Voice ? "语音" : "文字")</td>
                        <td>
                            <span class="badge @StatusBadge(item.Entry.TranscriptionStatus)">@StatusText(item.Entry.TranscriptionStatus)</span>
                            @if (item.FailureCode is { Length: > 0 } failureCode)
                            {
                                <div class="hint"><code>@(failureCode)</code></div>
                            }
                        </td>
                        <td>
                            @if (item.Entry.TranscriptForGeneration is { Length: > 0 } transcript)
                            {
                                @if (item.Entry.RevisedTranscript is { Length: > 0 })
                                {
                                    <div class="hint">已修订（原稿仍保留）</div>
                                }

                                <div class="transcript">@transcript</div>
                            }
                            else
                            {
                                <span class="muted">还没有文字。</span>
                            }
                        </td>
                        <td>
                            @if (item.Entry.HasAudio)
                            {
                                @* Served by GET /api/inputs/{id}/audio, which accepts the administrator's cookie
                                   as well as a device token — the same bytes the phone plays (§15.2 step 6). *@
                                <audio controls preload="none" src="@($"/api/inputs/{item.Entry.Id}/audio")" style="width: 15rem"></audio>
                                <div class="hint">
                                    @(item.Entry.AudioDuration is { } duration ? $"{duration.TotalSeconds:0.0} 秒" : "时长未知")
                                    · @item.Entry.AudioContentType
                                </div>
                            }
                            else
                            {
                                <span class="muted">已清理</span>
                                <div class="hint">保留策略到期后只删音频，文字与记录保留。</div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p class="hint">
        共 @_inputs.Count 条。音频的保留天数在<a href="/publishing">发布</a>页的「内容与时间」里配置
        （默认草稿确认后保留 30 天，<code>-1</code> 为永久）。
    </p>
}

<h2>当天的草稿</h2>

@if (_reflection is null)
{
    <p class="notice info">这一天还没有草稿。生成时刻与「哪些日子够格」由<a href="/publishing">发布</a>页的时间设置和调度器决定。</p>
}
else
{
    <div class="card">
        <div class="card-head">
            <h3>@(_reflection.WorkingVersion?.Title ?? "（无标题）")</h3>
            <span class="badge badge-muted">@ReflectionStatusText(_reflection.Status)</span>
        </div>

        <p class="hint">
            版本 ID <code>@_reflection.WorkingVersionId</code>
            @if (_reflection.WorkingVersion is { } version)
            {
                <text>· 生成于 @version.CreatedAtUtc.ToString("u")</text>
                @if (version.ModelName is { Length: > 0 } model)
                {
                    <text>· 模型 @model</text>
                }
                <text>· 来源引用 @version.Sources.Count 条 · 未溯源标红 @version.UnsourcedClaims.Count 条</text>
                @if (version.HasManualEdits)
                {
                    <text>· 含手工修改</text>
                }
            }
        </p>

        @if (_reflection.Status == ReflectionStatus.StaleByLateInput)
        {
            <p class="notice warn">这一天在成稿之后又有新的输入，稿子可能已经过时（客户端会提示重新生成）。</p>
        }

        @if (_reflection.WorkingVersion?.Body is { Length: > 0 } body)
        {
            <div class="transcript">@body</div>
        }
        else
        {
            <p class="muted">这个版本还没有正文。</p>
        }

        @if (_reflection.ConfirmedVersionIsNotWorking)
        {
            <p class="hint">已确认的版本与当前工作版本不是同一个 —— 工作版本改过但还没重新确认。</p>
        }
    </div>
}

@code {
    private string _date = string.Empty;
    private IReadOnlyList<InputStatusView>? _inputs;
    private ReflectionView? _reflection;
    private string? _error;
    private bool _busy;

    private ILogger Logger => LoggerFactory.CreateLogger("DailyMusings.Admin.Inputs");

    protected override async Task OnInitializedAsync()
    {
        _error = await AdminOperation.RunAsync(
            async () =>
            {
                await GoToTodayAsync(keepDate: false);
            },
            Logger);
    }

    private async Task LoadAsync()
    {
        _busy = true;
        _error = null;

        try
        {
            if (!ContentDate.TryParse(_date, out var day))
            {
                _error = "日期需要写成 YYYY-MM-DD。";
                return;
            }

            var failure = await AdminOperation.RunAsync(
                async () =>
                {
                    await using var scope = ScopeFactory.CreateAsyncScope();
                    var services = scope.ServiceProvider;

                    _inputs = await services
                        .GetRequiredService<ListInputsUseCase>()
                        .ExecuteAsync(day, recentLimit: 1, CancellationToken.None);

                    _reflection = await services
                        .GetRequiredService<GetReflectionUseCase>()
                        .ExecuteAsync(day, CancellationToken.None);
                },
                Logger);

            if (failure is not null)
            {
                _error = failure;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Reads the instance's own notion of today: the content day, which is the instance's time zone's.</summary>
    private async Task GoToTodayAsync() => await GoToTodayAsync(keepDate: false);

    private async Task GoToTodayAsync(bool keepDate)
    {
        if (!keepDate)
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var services = scope.ServiceProvider;

            var calendar = await services
                .GetRequiredService<IContentCalendarProvider>()
                .GetCalendarAsync(CancellationToken.None);

            var clock = services.GetRequiredService<IClock>();
            _date = calendar.ContentDateOf(clock.UtcNow).ToString();
        }

        await LoadAsync();
    }

    /// <summary>
    /// The moment the device saw, using the offset it recorded. A capture's time is a property of the capture, not
    /// of the server's clock — that is why the entry carries its own offset.
    /// </summary>
    private static string DeviceLocalTime(InputEntry entry) =>
        entry.CreatedAtUtc
            .ToOffset(TimeSpan.FromMinutes(entry.CreatedOffsetMinutes))
            .ToString("yyyy-MM-dd HH:mm:ss");

    private static string StatusText(TranscriptionStatus status) => status switch
    {
        TranscriptionStatus.Succeeded => "已转写",
        TranscriptionStatus.Pending => "等待转写",
        TranscriptionStatus.InProgress => "转写中",
        TranscriptionStatus.Failed => "转写失败",
        _ => "不需要转写",
    };

    private static string StatusBadge(TranscriptionStatus status) => status switch
    {
        TranscriptionStatus.Succeeded => "badge-ok",
        TranscriptionStatus.Failed => "badge-err",
        TranscriptionStatus.Pending or TranscriptionStatus.InProgress => "badge-warn",
        _ => "badge-muted",
    };

    private static string ReflectionStatusText(ReflectionStatus status) => status switch
    {
        ReflectionStatus.PendingInputs => "还没成稿",
        ReflectionStatus.Ready => "已成稿",
        ReflectionStatus.Generating => "生成中",
        ReflectionStatus.ReviewRequired => "待核验",
        ReflectionStatus.Confirmed => "已确认",
        ReflectionStatus.Failed => "生成失败",
        ReflectionStatus.StaleByLateInput => "已过时（有新输入）",
        _ => status.ToString(),
    };
}
