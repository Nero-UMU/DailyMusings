@page "/publishing"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IServiceScopeFactory ScopeFactory
@inject ILoggerFactory LoggerFactory

<PageHeader Title="发布设置" Hint="管理稿件何时生成、何时发布、生成时遵循的写作规范，以及两个 Markdown 输出目录。">
    <Actions>
        <button class="btn" @onclick="ReloadAsync" disabled="@_busy">刷新状态</button>
        <button class="btn-primary" @onclick="SaveAsync" disabled="@_busy">保存发布设置</button>
    </Actions>
</PageHeader>

@if (_message is not null) { <p class="notice ok">@_message</p> }
@if (_error is not null) { <p class="notice error">@_error</p> }

<section class="publish-actions">
    <article class="card action-card">
        <div><span class="eyebrow">生成</span><h2>今天的稿件</h2>
            <p class="hint">调用文章模型；完成后 Markdown 草稿会写入 <code>@_draftDirectory</code>。</p></div>
        <div class="action-state">
            <span class="badge @(_reflection is null ? "badge-muted" : AdminLabels.ReflectionBadge(_reflection.Status))">
                @(_reflection is null ? "尚未生成" : AdminLabels.ReflectionText(_reflection.Status))
            </span>
            <button class="btn-primary" @onclick="GenerateTodayAsync" disabled="@_busy">立即生成稿件</button>
        </div>
    </article>
    <article class="card action-card public-card">
        <div><span class="eyebrow">发布</span><h2>发布今天的稿件</h2>
            <p class="hint">写入 <code>@_publishedDirectory</code>，front matter 中设置 <code>draft: false</code>。</p></div>
        <div class="action-state">
            <span class="badge @PublicationBadge()">@PublicationText()</span>
            <button class="btn-primary" @onclick="PublishTodayAsync" disabled="@_busy">发布稿件</button>
        </div>
    </article>
</section>

<div class="settings-grid">
    <section class="card settings-card">
        <div class="card-head"><div><span class="eyebrow">自动生成</span><h2>生成计划</h2></div></div>
        <div class="form-grid compact-grid">
            <label>每日自动生成时间<input type="time" value="@_generationTime" @onchange="e => _generationTime = (string?)e.Value ?? _generationTime" /></label>
            <label>稿件输出目录<input value="@_draftDirectory" @oninput="e => _draftDirectory = (string?)e.Value ?? string.Empty" /></label>
        </div>
        <p class="hint">目录是**相对于你映射给实例的数据目录**的路径：映射了
            <code>/home/atri/data:/var/lib/dailymusings</code>、这里填 <code>aaa/bbb/posts</code>，稿件就会写到
            宿主上的 <code>/home/atri/data/aaa/bbb/posts</code>。不能使用绝对路径或 <code>..</code>。
            时间都是 <strong>@_timeZoneId</strong> 时区的墙上时间；时区在系统设置中修改。</p>
    </section>

    <section class="card settings-card">
        <div class="card-head">
            <div><span class="eyebrow">自动发布</span><h2>发布计划</h2></div>
            <label class="switch-line"><input type="checkbox" checked="@_automaticPublish" @onchange="e => _automaticPublish = e.Value is true" />允许自动公开发布</label>
        </div>
        <div class="form-grid compact-grid">
            <label>每日自动发布时间<input type="time" value="@_publishTime" @onchange="e => _publishTime = (string?)e.Value ?? _publishTime" /></label>
            <label>稿件发布目录<input value="@_publishedDirectory" @oninput="e => _publishedDirectory = (string?)e.Value ?? string.Empty" /></label>
        </div>
        <p class="hint">与输出目录同一套规则：相对于你映射给实例的<strong>数据目录</strong>，
            例如 <code>posts</code> 或 <code>aaa/bbb/posts</code>。</p>

        @* 调度预览：把服务端算出来的时刻直接写出来。用户勾了自动发布却什么都不发生时，唯一能解释的是这一行——
           旧版本只显示两个时间输入框，从不说明「哪一天、几点、还差什么」，于是失败只能表现为沉默。 *@
        <p class="hint schedule-preview">
            今天（@_today）的自动生成时刻是 <strong>@Local(_generationSlot)</strong>；
            这一天的稿件在 <strong>@Local(_publishSlot)</strong> 自动发布
            @(_publishIsSameDay ? "（发布时间晚于生成时间，所以是当天）" : "（发布时间早于生成时间，所以是次日）")。
        </p>
        <p class="hint">@AutoPublishStateText()</p>

        <p class="notice warn slim">自动发布会按上面的时间，自己把已确认的稿件写成 <code>draft: false</code> 的文件；不会绕过内容核验，也不会公开未经确认的稿件。勾选即生效，保存后立即按新开关执行。</p>
    </section>
</div>

<section class="card template-card">
    <div class="card-head">
        <div><span class="eyebrow">模型</span><h2>博客生成规范</h2></div>
        <button class="btn btn-sm" @onclick="ResetWritingRules" disabled="@_busy">恢复默认清单</button>
    </div>
    <p class="hint">这些规范会在生成时前置给文章模型，与当天的随想一起提交。默认条目可以直接改写或删掉；
        全部删掉也有效，那时只会告诉模型篇幅和人称。</p>

    <div class="form-grid compact-grid">
        <label>最少字数
            <input type="number" min="@WritingSettings.MinAllowedCharacters" max="@WritingSettings.MaxAllowedCharacters"
                   value="@_writingMinCharacters"
                   @oninput="e => _writingMinCharacters = (string?)e.Value ?? string.Empty" />
            <span class="hint">正文汉字数，不含 Markdown 标记。</span>
        </label>
        <label>最多字数
            <input type="number" min="@WritingSettings.MinAllowedCharacters" max="@WritingSettings.MaxAllowedCharacters"
                   value="@_writingMaxCharacters"
                   @oninput="e => _writingMaxCharacters = (string?)e.Value ?? string.Empty" />
            <span class="hint">必须大于最少字数。</span>
        </label>
        <label>人称
            <select value="@_writingPerson" @onchange="e => _writingPerson = (string?)e.Value ?? ContentSettings.WritingPersonFirst">
                <option value="@ContentSettings.WritingPersonFirst">第一人称（我）</option>
                <option value="@ContentSettings.WritingPersonSecond">第二人称（你）</option>
                <option value="@ContentSettings.WritingPersonThird">第三人称（他 / 她）</option>
            </select>
        </label>
    </div>

    <div class="form-grid compact-grid">
        <label class="switch-line">
            <input type="checkbox" checked="@_writingToleranceEnabled"
                   @onchange="e => _writingToleranceEnabled = e.Value is true" />
            允许公差：素材多寡可以决定略微超出区间
        </label>
        <label>公差（字）
            <input type="number" min="0" max="@WritingSettings.MaxAllowedTolerance"
                   value="@_writingToleranceCharacters" disabled="@(!_writingToleranceEnabled)"
                   @oninput="e => _writingToleranceCharacters = (string?)e.Value ?? string.Empty" />
            <span class="hint">勾选后模型可以比最少再少、比最多再多这么多字；取消勾选表示严格落在区间内。</span>
        </label>
    </div>

    <div class="writing-rules">
        @for (var i = 0; i < _writingRules.Count; i++)
        {
            var index = i;
            <div class="writing-rule">
                <input class="rule-title" value="@_writingRules[index].Title" placeholder="规范名称，例如「行文风格」"
                       @oninput="e => _writingRules[index] = _writingRules[index] with { Title = (string?)e.Value ?? string.Empty }" />
                <textarea class="rule-instruction" value="@_writingRules[index].Instruction" placeholder="写给模型的要求"
                          @oninput="e => _writingRules[index] = _writingRules[index] with { Instruction = (string?)e.Value ?? string.Empty }"></textarea>
                <button class="btn btn-sm btn-danger" @onclick="() => RemoveWritingRule(index)" disabled="@_busy">删除</button>
            </div>
        }
        @if (_writingRules.Count == 0)
        {
            <p class="empty-state">目前没有任何规范条目。</p>
        }
    </div>

    <div class="actions">
        <button class="btn btn-sm" @onclick="AddWritingRule" disabled="@_busy">添加一条规范</button>
        <span class="hint">最多 @WritingSettings.MaxRules 条；标题不超过 @WritingRule.MaxTitleLength 字，内容不超过 @WritingRule.MaxInstructionLength 字。</span>
    </div>
</section>

<section class="card template-card">
    <div class="card-head"><div><span class="eyebrow">Hexo</span><h2>Front matter 模板</h2></div>
        <button class="btn btn-sm" @onclick="ResetTemplate" disabled="@_busy">恢复默认</button></div>
    <textarea class="template-editor" spellcheck="false" value="@_hexoTemplate" @oninput="e => _hexoTemplate = (string?)e.Value ?? string.Empty"></textarea>
    <p class="hint">可用：<code>{title}</code>、<code>{date}</code>、<code>{updated}</code>、<code>{tags}</code>、<code>{categories}</code>、<code>{draft}</code>、<code>{summary}</code>、<code>{slug}</code>、<code>{body}</code>。模板必须包含 <code>{body}</code>。</p>
</section>

<section class="card">
    <div class="card-head"><div><span class="eyebrow">记录</span><h2>最近发布</h2></div></div>
    @if (_recent.Count == 0) { <p class="empty-state">还没有发布记录。</p> }
    else
    {
        <div class="publication-list">
        @foreach (var item in _recent.Take(12))
        {
            <div class="publication-row"><span class="badge @AdminLabels.PublicationBadge(item.Publication.Status)">@AdminLabels.PublicationText(item.Publication.Status)</span>
                <div><strong>@item.TargetName</strong><p class="hint">@AdminFormat.When(item.Publication.ScheduledAtUtc) · @(item.Publication.RemoteId ?? "等待生成文件")</p></div></div>
        }
        </div>
    }
</section>

@code {
    private const string PublicTargetName = "稿件发布目录";
    private ContentDate _today;
    private ReflectionView? _reflection;
    private PublishTarget? _publishTarget;
    private IReadOnlyList<PublicationView> _recent = [];
    private string _timeZoneId = ContentSettings.DefaultTimeZoneId;
    private string _generationTime = "23:00";
    private string _publishTime = "08:00";
    private DateTimeOffset? _generationSlot;
    private DateTimeOffset? _publishSlot;
    private bool _publishIsSameDay = true;
    private string _draftDirectory = ContentSettings.DefaultDraftDirectory;
    private string _publishedDirectory = ContentSettings.DefaultPublishedDirectory;
    private string _hexoTemplate = MarkdownTemplate.Default;
    private string _writingMinCharacters = WritingSettings.DefaultMinCharacters.ToString(CultureInfo.InvariantCulture);
    private string _writingMaxCharacters = WritingSettings.DefaultMaxCharacters.ToString(CultureInfo.InvariantCulture);
    private string _writingToleranceCharacters = WritingSettings.DefaultCharacterTolerance.ToString(CultureInfo.InvariantCulture);
    private bool _writingToleranceEnabled = true;
    private string _writingPerson = ContentSettings.FormatPerson(WritingSettings.Default.Person);
    private List<WritingRule> _writingRules = [.. WritingSettings.DefaultRules];
    private bool _automaticPublish;
    private bool _busy;
    private string? _message;
    private string? _error;
    private ILogger Logger => LoggerFactory.CreateLogger("DailyMusings.Admin.Publishing");

    protected override async Task OnInitializedAsync() => _error = await AdminOperation.RunAsync(LoadAsync, Logger);

    private async Task LoadAsync()
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        var services = scope.ServiceProvider;
        var calendar = await services.GetRequiredService<IContentCalendarProvider>().GetCalendarAsync(CancellationToken.None);
        _today = calendar.ContentDateOf(services.GetRequiredService<IClock>().UtcNow);
        _reflection = await services.GetRequiredService<GetReflectionUseCase>().ExecuteAsync(_today, CancellationToken.None);
        var settings = await services.GetRequiredService<IContentSettingsProvider>().GetAsync(CancellationToken.None);
        _timeZoneId = settings.TimeZoneId;
        _generationTime = ContentSettings.FormatTime(settings.GenerationLocalTime);
        _publishTime = ContentSettings.FormatTime(settings.PublishLocalTime);

        // 调度预览用的两个时刻，按服务端同一套规则算（ContentSettings.PublishSlotFor），页面不自己解释时间。
        _generationSlot = settings.CreateCalendar().AtLocalTime(_today, settings.GenerationLocalTime);
        _publishSlot = settings.PublishSlotFor(_today);
        _publishIsSameDay = settings.PublishLocalTime >= settings.GenerationLocalTime;
        _draftDirectory = settings.DraftDirectory;
        _publishedDirectory = settings.PublishedDirectory;
        _hexoTemplate = settings.HexoFrontMatterTemplate;
        _writingMinCharacters = settings.Writing.MinCharacters.ToString(CultureInfo.InvariantCulture);
        _writingMaxCharacters = settings.Writing.MaxCharacters.ToString(CultureInfo.InvariantCulture);
        _writingToleranceCharacters = settings.Writing.CharacterTolerance.ToString(CultureInfo.InvariantCulture);
        _writingToleranceEnabled = settings.Writing.AllowsTolerance;
        _writingPerson = ContentSettings.FormatPerson(settings.Writing.Person);
        _writingRules = [.. settings.Writing.Rules];
        var targets = await services.GetRequiredService<ListPublishTargetsUseCase>().ExecuteAsync(CancellationToken.None);
        _publishTarget = targets.FirstOrDefault(target => target.Name == PublicTargetName);
        _automaticPublish = _publishTarget?.AutomaticPublishEnabled ?? false;
        _recent = await services.GetRequiredService<ListPublicationsUseCase>().ExecuteAsync(50, CancellationToken.None);
    }

    private async Task ReloadAsync() => await RunAsync(async _ => await LoadAsync(), "状态已刷新。");

    private async Task GenerateTodayAsync() => await RunAsync(async services =>
    {
        var result = await services.GetRequiredService<RequestReflectionGenerationUseCase>().ExecuteAsync(
            _today, manual: true, ignoreTranscriptionFailures: true, allowOverwriteOfManualEdits: false, CancellationToken.None);
        if (!result.Decision.Allowed)
            throw new UseCaseException(result.Decision.Code ?? "reflection.generation.refused", AdminLabels.GenerationRefusalText(result.Decision.Code, result.Decision.Detail));
        await LoadAsync();
    }, "生成任务已提交；完成后会写入稿件输出目录。");

    private async Task PublishTodayAsync() => await RunAsync(async services =>
    {
        await EnsurePublicTargetAsync(services);
        _reflection = await services.GetRequiredService<GetReflectionUseCase>().ExecuteAsync(_today, CancellationToken.None);
        if (_reflection?.WorkingVersion is null)
            throw new UseCaseException("publication.reflection_unknown", "今天还没有可发布的稿件。");
        if (_reflection.Status != ReflectionStatus.Confirmed)
        {
            if (_reflection.WorkingVersion.SourcesCheckedAtUtc is null)
                throw new UseCaseException("reflection.confirm.source_check_pending", "来源检查尚未完成，请稍后刷新再发布。");
            _reflection = await services.GetRequiredService<ConfirmReflectionUseCase>().ExecuteAsync(
                _today, new DailyMusings.Application.Reflections.ConfirmReflectionRequest(AcceptedUnsourcedClaims: true), CancellationToken.None);
        }
        var result = await services.GetRequiredService<RequestPublicationUseCase>().ExecuteAsync(
            _today, _publishTarget!.Id, PublicationVisibility.Public, "admin", false, manual: true, CancellationToken.None);
        if (!result.Queued)
            throw new UseCaseException(result.Code ?? "publication.refused", AdminLabels.PublicationRefusalText(result.Code, result.Detail));
        await LoadAsync();
    }, "稿件已进入发布队列。");

    private async Task SaveAsync() => await RunAsync(async services =>
    {
        var generation = ParseTimeOrThrow(_generationTime, "生成时间");
        var publish = ParseTimeOrThrow(_publishTime, "发布时间");

        if (!int.TryParse(_writingMinCharacters, out var minCharacters))
            throw new UseCaseException("writing.min.invalid", "最少字数必须是数字。");

        if (!int.TryParse(_writingMaxCharacters, out var maxCharacters))
            throw new UseCaseException("writing.max.invalid", "最多字数必须是数字。");

        // 在页面上先说清楚，别等保存时才由领域抛「最少必须小于最多」——那条消息里没有输入框的名字。
        if (minCharacters >= maxCharacters)
            throw new UseCaseException("writing.range.invalid", $"最少字数必须小于最多字数（现在是 {minCharacters} 与 {maxCharacters}）。");

        if (!int.TryParse(_writingToleranceCharacters, out var toleranceCharacters))
            throw new UseCaseException("writing.tolerance.invalid", "公差必须是数字。");

        if (!ContentSettings.TryParsePerson(_writingPerson, out var writingPerson))
            throw new UseCaseException("writing.person.invalid", "人称只能是第一、第二或第三人称。");

        await services.GetRequiredService<UpdateContentSettingsUseCase>().ExecuteAsync(
            new ContentSettingsUpdate(
                null, generation, publish, null, null, null, _draftDirectory, _publishedDirectory, _hexoTemplate,
                minCharacters, maxCharacters, _writingToleranceEnabled ? toleranceCharacters : 0,
                writingPerson, CollectWritingRules()),
            CancellationToken.None);
        await EnsurePublicTargetAsync(services);
        await services.GetRequiredService<UpdatePublishTargetUseCase>().ExecuteAsync(
            _publishTarget!.Id, null, _publishedDirectory, CancellationToken.None);
        if (_automaticPublish != _publishTarget.AutomaticPublishEnabled)
            await services.GetRequiredService<SetAutomaticPublishUseCase>().ExecuteAsync(
                _publishTarget.Id, _automaticPublish, CancellationToken.None);
        await LoadAsync();
    }, "发布设置已保存，下一次调度立即使用新配置。");

    private async Task EnsurePublicTargetAsync(IServiceProvider services)
    {
        if (_publishTarget is not null) return;
        _publishTarget = (await services.GetRequiredService<CreatePublishTargetUseCase>().ExecuteAsync(
            PublicTargetName, PublishTargetType.Markdown, _publishedDirectory, CancellationToken.None)).Target;
    }

    /// <summary>
    /// 读两个时间字段，并在**哪一个**不对时点名说清。
    /// <para>
    /// 旧写法把两个字段塞进同一个条件里、一起报「生成和发布时间都必须是 HH:mm」，恰好把真正的原因挡住了：
    /// <c>&lt;input type="time"&gt;</c> 交给 Blazor 的是带秒的往返格式，于是严格按 <c>HH:mm</c> 解析会把一次
    /// 完全正常的修改判成非法，还顺手冤枉另一个字段。解析现在统一在
    /// <see cref="AdminFormat.TryParseTimeOfDay"/>（见 CHANGELOG 2026-09-29 第七轮）。
    /// </para>
    /// </summary>
    private static TimeOnly ParseTimeOrThrow(string? value, string label)
    {
        if (AdminFormat.TryParseTimeOfDay(value, out var parsed))
        {
            return parsed;
        }

        var text = (value ?? string.Empty).Trim();

        throw (text.Length == 0
            ? new UseCaseException("publish.time.empty", $"{label}还是空的：请填一个完整的时间，例如 08:00。")
            : new UseCaseException("publish.time.invalid", $"{label}「{text}」看不懂：请写成 HH:mm，例如 08:00。"));
    }

    private void ResetTemplate() => _hexoTemplate = MarkdownTemplate.Default;
    private void AddWritingRule() => _writingRules.Add(new WritingRule(string.Empty, string.Empty));

    private void RemoveWritingRule(int index)
    {
        if (index >= 0 && index < _writingRules.Count)
        {
            _writingRules.RemoveAt(index);
        }
    }

    private void ResetWritingRules() => _writingRules = [.. WritingSettings.DefaultRules];

    /// <summary>
    /// Trims what the user typed and drops rows they left completely blank: an empty row is a half-finished edit,
    /// not a rule, and failing the whole save over one would be hostile. A row that is filled in only halfway is a
    /// mistake, and the domain validation names it rather than dropping it silently.
    /// </summary>
    private IReadOnlyList<WritingRule> CollectWritingRules() =>
        _writingRules
            .Select(rule => new WritingRule(rule.Title.Trim(), rule.Instruction.Trim()))
            .Where(rule => rule.Title.Length > 0 || rule.Instruction.Length > 0)
            .ToArray();
    private PublicationStatus? TodayPublicationStatus() => _recent.FirstOrDefault(item =>
        _reflection?.WorkingVersion is { } workingVersion &&
        item.Publication.ReflectionId == _reflection.Id &&
        item.Publication.ReflectionVersionId == workingVersion.Id)?.Publication.Status;
    private string PublicationText() => TodayPublicationStatus() is { } status ? AdminLabels.PublicationText(status) : "尚未发布";
    private string PublicationBadge() => TodayPublicationStatus() is { } status ? AdminLabels.PublicationBadge(status) : "badge-muted";

    /// <summary>今日稿件在内容时区里的时刻，用来把服务端算出的调度直接写给人看。</summary>
    private string Local(DateTimeOffset? moment) => moment is { } value
        ? TimeZoneInfo.ConvertTime(value, ContentTimeZone.FromId(_timeZoneId).TimeZoneInfo)
            .ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)
        : "—";

    /// <summary>
    /// 「为什么到点没有自动发布」的答案：开关状态 + 今天稿件的确认状态 + 今天是否已经发布过。
    /// <para>
    /// 自动发布只处理已确认的稿件，这是产品规则而不是故障；但旧页面从不说明这一点，用户看到的就只是沉默。
    /// </para>
    /// </summary>
    private string AutoPublishStateText()
    {
        var state = _reflection?.Status switch
        {
            null => "今天还没有稿件，先生成并确认它，自动发布才有对象。",
            not ReflectionStatus.Confirmed =>
                "今天的稿件还没有确认——自动发布只处理已确认的稿件，它不会替你确认，所以到点也不会有动作。",
            _ when TodayPublicationStatus() == PublicationStatus.Published => "今天的稿件已确认，而且已经发布过了。",
            _ => "今天的稿件已确认，到上面的时刻会自动发布。",
        };

        return (_automaticPublish ? "自动公开：已开启。" : "自动公开：未开启，到点只写草稿（draft: true）。") + state;
    }

    private async Task RunAsync(Func<IServiceProvider, Task> work, string success)
    {
        _busy = true; _message = null; _error = null;
        try
        {
            var failure = await AdminOperation.RunAsync(async () =>
            {
                await using var scope = ScopeFactory.CreateAsyncScope();
                await work(scope.ServiceProvider);
            }, Logger);
            if (failure is null) _message = success; else _error = failure;
        }
        finally { _busy = false; }
    }
}
