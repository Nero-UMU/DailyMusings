@page "/publishing"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IServiceScopeFactory ScopeFactory
@inject ILoggerFactory LoggerFactory

<h1>发布目标</h1>

<p class="hint">
    发布目标就是一个 <strong>Markdown 目录</strong>：确认过的草稿会被导出成 <code>.md</code> 文件写进这个目录，
    由 Hexo 去读取。文件永远只写在实例的 markdown 目录之内。
</p>

@if (_error is not null)
{
    <p class="notice error">@_error</p>
}

@if (_enabled is not null)
{
    <p class="notice ok">
        已为 <strong>@_enabled.Name</strong> 开启自动发布，开启人：@_enabled.AutomaticPublishEnabledBy。
        <br />
        此后该目标在每个发布时刻会<strong>无人确认地导出一份 Markdown</strong>。
    </p>
}

@if (_disabled is not null)
{
    <p class="notice ok">已为 <strong>@_disabled</strong> 关闭自动发布。</p>
}

@if (_targets is null)
{
    <p class="muted">正在读取…</p>
}
else if (_targets.Count == 0)
{
    <p class="notice info">还没有发布目标。用下面的表单添加一个 Markdown 目录。</p>
}
else
{
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>名称</th>
                    <th>类型</th>
                    <th>目录</th>
                    <th>自动发布</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var target in _targets)
                {
                    <tr>
                        <td><strong>@target.Name</strong></td>
                        <td>Markdown（Hexo）</td>
                        <td><code>@(target.DestinationReference ?? "（默认）")</code></td>
                        <td>
                            @if (target.AutomaticPublishEnabled)
                            {
                                <span class="badge badge-warn">已开启</span>
                                <div class="hint">
                                    @target.AutomaticPublishEnabledBy
                                    @(target.AutomaticPublishEnabledAtUtc?.ToString("u"))
                                </div>
                            }
                            else
                            {
                                <span class="badge badge-muted">关闭</span>
                                <div class="hint">只在你手动导出时写文件</div>
                            }
                        </td>
                        <td>
                            @if (_confirming == target.Id)
                            {
                                <div class="risk">
                                    @if (_confirmActionIsEnable)
                                    {
                                        <strong>开启后，@target.Name 会在无人确认的情况下导出文章。</strong>
                                        <p>只有在你有意让这个目标自动导出时才继续。请重新输入管理员密码以确认：</p>
                                    }
                                    else
                                    {
                                        <strong>关闭后，@target.Name 只会在你手动导出时写文件。</strong>
                                        <p>服务端对开启和关闭都要求当前密码，所以要撤销它同样需要重新输入：</p>
                                    }

                                    <input type="password" @bind="_password" placeholder="当前密码" />
                                    <div class="actions">
                                        <button class="btn-primary btn-sm"
                                                @onclick="() => ApplyConfirmAsync(target)"
                                                disabled="@_busy">
                                            @(_confirmActionIsEnable ? "确认开启" : "确认关闭")
                                        </button>
                                        <button class="btn-sm" @onclick="CancelConfirm" disabled="@_busy">取消</button>
                                    </div>
                                </div>
                            }
                            else if (target.AutomaticPublishEnabled)
                            {
                                <button class="btn-sm" @onclick="() => BeginConfirm(target, enable: false)" disabled="@_busy">
                                    关闭自动发布…
                                </button>
                            }
                            else
                            {
                                <button class="btn-sm" @onclick="() => BeginConfirm(target, enable: true)" disabled="@_busy">
                                    开启自动发布…
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p class="hint">
        对 Markdown 目标来说，「公开」与「草稿」的差别就是导出文件里 <code>draft</code> 字段的真假：
        <code>draft: true</code> 的文章 Hexo 不会生成到站点上，<code>draft: false</code> 才会。
        开启自动发布后，每个发布时刻都会按目标当下的选择自动导出一次，不再需要有人在客户端点击。
    </p>
}

<h2>添加目标</h2>

<div class="form-grid">
    <label>
        名称
        <input @bind="_newName" placeholder="hexo" />
    </label>
    <label>
        目录
        <input @bind="_newDestination" placeholder="例如 _drafts，留空即实例的 markdown 根目录" />
    </label>
</div>

<div class="actions">
    <button class="btn-primary" @onclick="CreateAsync" disabled="@_busy">添加</button>
</div>

<p class="hint">
    目录填<strong>相对路径</strong>，相对于实例的 markdown 目录（例如 Hexo 的 <code>source/_drafts</code> 对应的挂载位置）。
    绝对路径或试图跳出这个根目录的路径都会被拒绝。
</p>

<h2>内容与时间</h2>

<p class="hint">
    时间都是内容时区里的本地时刻。生成时刻决定当晚何时成稿；发布时刻决定次日何时进入导出队列，
    而执行窗口决定「错过了多久就不许再自动执行」。
</p>

@if (_scheduleError is not null)
{
    <p class="notice error">@_scheduleError</p>
}

@if (_scheduleSaved is not null)
{
    <p class="notice ok">已保存：@_scheduleSaved</p>
}

@if (_settings is null)
{
    <p class="muted">正在读取…</p>
}
else
{
    <div class="form-grid">
        <label>
            内容时区
            <input @bind="_timeZoneId" />
        </label>
        <label>
            生成时刻
            <input @bind="_generationTime" placeholder="23:00" />
        </label>
        <label>
            发布时刻
            <input @bind="_publishTime" placeholder="08:00" />
        </label>
        <label>
            执行窗口（分钟）
            <input type="number" @bind="_publishWindow" />
        </label>
        <label>
            音频保留天数
            <input type="number" @bind="_audioRetentionDays" />
        </label>
    </div>

    <div class="actions">
        <button class="btn-primary" @onclick="SaveSettingsAsync" disabled="@_busy">保存</button>
    </div>

    <p class="hint">
        音频保留：<code>-1</code> = 永久保留，<code>0</code> = 当天草稿确认后立即删除，默认 30 天。
        到期只删音频文件，转写与输入记录保留。
    </p>
}

@code {
    private IReadOnlyList<PublishTarget>? _targets;
    private PublishTargetId? _confirming;
    private bool _confirmActionIsEnable;
    private string _password = string.Empty;
    private string _newName = string.Empty;
    private string _newDestination = string.Empty;
    private string? _error;
    private PublishTarget? _enabled;
    private string? _disabled;
    private bool _busy;

    private ContentSettings? _settings;
    private string _timeZoneId = string.Empty;
    private string _generationTime = string.Empty;
    private string _publishTime = string.Empty;
    private int _publishWindow;
    private int _audioRetentionDays;
    private string? _scheduleError;
    private string? _scheduleSaved;

    private ILogger Logger => LoggerFactory.CreateLogger("DailyMusings.Admin.Publishing");

    protected override async Task OnInitializedAsync()
    {
        _error = await AdminOperation.RunAsync(
            async () =>
            {
                await LoadAsync();
                await LoadSettingsAsync();
            },
            Logger);
    }

    private async Task LoadAsync()
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        _targets = await scope.ServiceProvider
            .GetRequiredService<ListPublishTargetsUseCase>()
            .ExecuteAsync(CancellationToken.None);
    }

    private async Task LoadSettingsAsync()
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        _settings = await scope.ServiceProvider
            .GetRequiredService<IContentSettingsProvider>()
            .GetAsync(CancellationToken.None);

        _timeZoneId = _settings.TimeZoneId;
        _generationTime = ContentSettings.FormatTime(_settings.GenerationLocalTime);
        _publishTime = ContentSettings.FormatTime(_settings.PublishLocalTime);
        _publishWindow = _settings.PublishWindowMinutes;
        _audioRetentionDays = _settings.AudioRetentionDays;
    }

    /// <summary>
    /// Parses the two times here rather than in the use case, so a typo is reported next to the field that has it.
    /// The use case validates everything else — the time zone above all, since a bad zone id would otherwise only
    /// surface when a capture failed.
    /// </summary>
    private async Task SaveSettingsAsync()
    {
        _busy = true;
        _scheduleError = null;
        _scheduleSaved = null;

        try
        {
            if (!TimeOnly.TryParseExact(_generationTime, "HH:mm", CultureInfo.InvariantCulture, DateTimeStyles.None, out var generation) ||
                !TimeOnly.TryParseExact(_publishTime, "HH:mm", CultureInfo.InvariantCulture, DateTimeStyles.None, out var publish))
            {
                _scheduleError = "时刻需要写成 HH:mm，例如 23:00。";
                return;
            }

            ContentSettings? saved = null;

            var failure = await AdminOperation.RunAsync(
                async () =>
                {
                    await using var scope = ScopeFactory.CreateAsyncScope();
                    saved = await scope.ServiceProvider
                        .GetRequiredService<UpdateContentSettingsUseCase>()
                        .ExecuteAsync(
                            new ContentSettingsUpdate(_timeZoneId, generation, publish, _publishWindow, _audioRetentionDays),
                            CancellationToken.None);
                },
                Logger);

            if (failure is not null)
            {
                _scheduleError = failure;
                return;
            }

            if (saved is not null)
            {
                _settings = saved;
                _scheduleSaved = $"时区 {saved.TimeZoneId}，生成 {ContentSettings.FormatTime(saved.GenerationLocalTime)}，"
                    + $"发布 {ContentSettings.FormatTime(saved.PublishLocalTime)}，窗口 {saved.PublishWindowMinutes} 分钟。";
            }
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Starts the confirmation for either direction. Both need the password, because the use case requires it to
    /// turn the switch off as well — and the previous version rendered the password box only on the way in, so
    /// "关闭自动公开" always submitted an empty password, could never succeed, and left the opt-in impossible to
    /// revoke from the UI.
    /// </summary>
    private void BeginConfirm(PublishTarget target, bool enable)
    {
        _confirming = target.Id;
        _confirmActionIsEnable = enable;
        _password = string.Empty;
        _error = null;
        _enabled = null;
        _disabled = null;
    }

    private void CancelConfirm()
    {
        _confirming = null;
        _password = string.Empty;
    }

    private async Task CreateAsync()
    {
        _busy = true;
        _error = null;

        try
        {
            // Checked here as well as inside the use case: the use case rejects a blank name with ArgumentException,
            // which is not an operator-facing failure type, and an exception escaping an @onclick handler kills the
            // whole circuit — one empty click and every button on this page stops responding.
            if (string.IsNullOrWhiteSpace(_newName))
            {
                _error = "名称不能为空。";
                return;
            }

            var name = _newName;
            var destination = string.IsNullOrWhiteSpace(_newDestination) ? null : _newDestination;

            var failure = await AdminOperation.RunAsync(
                async () =>
                {
                    await using var scope = ScopeFactory.CreateAsyncScope();
                    await scope.ServiceProvider
                        .GetRequiredService<CreatePublishTargetUseCase>()
                        .ExecuteAsync(name, PublishTargetType.Markdown, destination, CancellationToken.None);
                },
                Logger);

            if (failure is not null)
            {
                _error = failure;
                return;
            }

            _newName = string.Empty;
            _newDestination = string.Empty;
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Applies the confirmed direction. One path for both directions, so the password requirement and the error
    /// reporting cannot drift apart the way they did when only the enable path had a password box.
    /// </summary>
    private async Task ApplyConfirmAsync(PublishTarget target)
    {
        _busy = true;
        _error = null;

        try
        {
            var enable = _confirmActionIsEnable;
            PublishTarget? updated = null;

            var failure = await AdminOperation.RunAsync(
                async () =>
                {
                    await using var scope = ScopeFactory.CreateAsyncScope();
                    updated = await scope.ServiceProvider
                        .GetRequiredService<SetAutomaticPublishUseCase>()
                        .ExecuteAsync(target.Id, enable, _password, CancellationToken.None);
                },
                Logger);

            if (failure is not null)
            {
                // §11.1: a rejected password matters more than a generic failure here — the operator has to know
                // that the switch is still in its previous position.
                _error = failure;
                return;
            }

            _confirming = null;
            _password = string.Empty;

            if (enable)
            {
                _enabled = updated;
            }
            else
            {
                _disabled = target.Name;
            }

            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}
