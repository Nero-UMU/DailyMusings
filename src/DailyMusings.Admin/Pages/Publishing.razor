@page "/publishing"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IServiceScopeFactory ScopeFactory
@inject ILoggerFactory LoggerFactory

<h1>发布目标</h1>

<p class="hint">
    发布默认只把文章作为<strong>私人草稿</strong>上传，等你在客户端确认后才公开。
    「自动公开」是唯一一种无人确认也会公开的路径，因此它只能在这里开启，且开启与关闭都要求重新输入管理员密码。
</p>

@if (_error is not null)
{
    <p class="notice error">@_error</p>
}

@if (_enabled is not null)
{
    <p class="notice ok">
        已为 <strong>@_enabled.Name</strong> 开启自动公开，开启人：@_enabled.AutomaticPublishEnabledBy。
        <br />
        此后该目标在每个发布时刻会<strong>无人确认地公开</strong>当天已确认的草稿。
    </p>
}

@if (_disabled is not null)
{
    <p class="notice ok">已为 <strong>@_disabled</strong> 关闭自动公开。</p>
}

@if (_targets is null)
{
    <p class="muted">正在读取…</p>
}
else if (_targets.Count == 0)
{
    <p class="notice info">还没有发布目标。用下面的表单添加一个 WordPress 站点或一个 Markdown 目录。</p>
}
else
{
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>名称</th>
                    <th>类型</th>
                    <th>目标</th>
                    <th>自动公开</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var target in _targets)
                {
                    <tr>
                        <td><strong>@target.Name</strong></td>
                        <td>@(target.Type == PublishTargetType.Markdown ? "Markdown" : "WordPress")</td>
                        <td><code>@(target.DestinationReference ?? "（默认）")</code></td>
                        <td>
                            @if (target.AutomaticPublishEnabled)
                            {
                                <span class="badge badge-warn">已开启</span>
                                <div class="hint">
                                    @target.AutomaticPublishEnabledBy
                                    @(target.AutomaticPublishEnabledAtUtc?.ToString("u"))
                                </div>
                            }
                            else
                            {
                                <span class="badge badge-muted">关闭</span>
                                <div class="hint">只上传草稿</div>
                            }
                        </td>
                        <td>
                            @if (_confirming == target.Id)
                            {
                                <div class="risk">
                                    @if (_confirmActionIsEnable)
                                    {
                                        <strong>开启后，@target.Name 会在无人确认的情况下公开文章。</strong>
                                        <p>只有在你有意让这个目标自动公开时才继续。请重新输入管理员密码以确认：</p>
                                    }
                                    else
                                    {
                                        <strong>关闭后，@target.Name 只会收到私人草稿。</strong>
                                        <p>服务端对开启和关闭都要求当前密码，所以要撤销它同样需要重新输入：</p>
                                    }

                                    <input type="password" @bind="_password" placeholder="当前密码" />
                                    <div class="actions">
                                        <button class="btn-primary btn-sm"
                                                @onclick="() => ApplyConfirmAsync(target)"
                                                disabled="@_busy">
                                            @(_confirmActionIsEnable ? "确认开启" : "确认关闭")
                                        </button>
                                        <button class="btn-sm" @onclick="CancelConfirm" disabled="@_busy">取消</button>
                                    </div>
                                </div>
                            }
                            else if (target.AutomaticPublishEnabled)
                            {
                                <button class="btn-sm" @onclick="() => BeginConfirm(target, enable: false)" disabled="@_busy">
                                    关闭自动公开…
                                </button>
                            }
                            else
                            {
                                <button class="btn-sm" @onclick="() => BeginConfirm(target, enable: true)" disabled="@_busy">
                                    开启自动公开…
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_targets is not null && _targets.Any(target => target.Type == PublishTargetType.WordPress))
{
    <h2>WordPress 站点设置</h2>

    <p class="hint">
        站点地址与应用密码的<strong>名字</strong>默认来自部署配置
        （<code>Publishing:WordPress:Targets:&lt;配置键&gt;</code>）。下面可以为某一个目标单独覆盖，
        <strong>留空的字段继续沿用配置</strong>；四个字段全空即清除覆盖。
        密码的<strong>值</strong>永远只放在 Docker Secrets 里，这里只能填名字。
    </p>

    @if (_siteError is not null)
    {
        <p class="notice error">@_siteError</p>
    }

    @if (_siteSaved is not null)
    {
        <p class="notice ok">@_siteSaved</p>
    }

    <div class="form-grid">
        <label>
            目标
            <select @bind="_siteTargetId" @bind:after="LoadSiteAsync">
                @foreach (var target in _targets.Where(t => t.Type == PublishTargetType.WordPress))
                {
                    <option value="@target.Id.ToString()">@target.Name</option>
                }
            </select>
        </label>
        <label>
            站点地址
            <input @bind="_siteBaseUrl" placeholder="https://blog.example.com" />
        </label>
        <label>
            用户名
            <input @bind="_siteUsername" placeholder="wordpress 登录名" />
        </label>
        <label>
            Secret 名
            <input @bind="_siteSecretName" placeholder="wordpress-application-password" />
        </label>
        <label>
            请求超时（秒）
            <input type="number" @bind="_siteTimeoutSeconds" />
        </label>
    </div>

    <div class="actions">
        <button class="btn-primary" @onclick="SaveSiteAsync" disabled="@_siteBusy">保存站点设置</button>
        <button @onclick="ClearSiteAsync" disabled="@_siteBusy">清除覆盖</button>
    </div>

    @if (_siteEffective is not null)
    {
        <p class="hint">
            当前<strong>实际生效</strong>的组合：地址 <code>@_siteEffective.EffectiveBaseUrl</code>，
            用户名 <code>@_siteEffective.EffectiveUsername</code>，
            Secret <code>@_siteEffective.EffectiveSecretName</code>，
            超时 @_siteEffective.EffectiveTimeoutSeconds 秒。
            @(_siteEffective.Overridden ? "其中部分字段来自本页覆盖。" : "全部来自部署配置。")
        </p>
    }
}

<h2>添加目标</h2>

<div class="form-grid">
    <label>
        名称
        <input @bind="_newName" placeholder="blog" />
    </label>
    <label>
        类型
        <select @bind="_newType">
            <option value="wordPress">WordPress</option>
            <option value="markdown">Markdown（Hexo）</option>
        </select>
    </label>
    <label>
        目标
        <input @bind="_newDestination" placeholder="WordPress 用配置键，Markdown 用相对目录" />
    </label>
</div>

<div class="actions">
    <button class="btn-primary" @onclick="CreateAsync" disabled="@_busy">添加</button>
</div>

<p class="hint">
    WordPress 目标填<strong>配置键</strong>（对应 <code>Publishing:WordPress:Targets:&lt;键&gt;</code>），
    密码以 Docker Secrets 的名称引用，不写进数据库。Markdown 目标填<strong>相对目录</strong>，
    相对于实例的 markdown 目录；导出永远只写这个目录之内。
</p>

<h2>内容与时间</h2>

<p class="hint">
    时间都是内容时区里的本地时刻。生成时刻决定当晚何时成稿；发布时刻决定次日何时进入发布队列，
    而执行窗口决定「错过了多久就不许再自动执行」。
</p>

@if (_scheduleError is not null)
{
    <p class="notice error">@_scheduleError</p>
}

@if (_scheduleSaved is not null)
{
    <p class="notice ok">已保存：@_scheduleSaved</p>
}

@if (_settings is null)
{
    <p class="muted">正在读取…</p>
}
else
{
    <div class="form-grid">
        <label>
            内容时区
            <input @bind="_timeZoneId" />
        </label>
        <label>
            生成时刻
            <input @bind="_generationTime" placeholder="23:00" />
        </label>
        <label>
            发布时刻
            <input @bind="_publishTime" placeholder="08:00" />
        </label>
        <label>
            执行窗口（分钟）
            <input type="number" @bind="_publishWindow" />
        </label>
        <label>
            音频保留天数
            <input type="number" @bind="_audioRetentionDays" />
        </label>
    </div>

    <div class="actions">
        <button class="btn-primary" @onclick="SaveSettingsAsync" disabled="@_busy">保存</button>
    </div>

    <p class="hint">
        音频保留：<code>-1</code> = 永久保留，<code>0</code> = 当天草稿确认后立即删除，默认 30 天。
        到期只删音频文件，转写与输入记录保留。
    </p>
}

@code {
    private IReadOnlyList<PublishTarget>? _targets;
    private PublishTargetId? _confirming;
    private bool _confirmActionIsEnable;
    private string _password = string.Empty;
    private string _newName = string.Empty;
    private string _newType = "wordPress";
    private string _newDestination = string.Empty;
    private string? _error;
    private PublishTarget? _enabled;
    private string? _disabled;
    private bool _busy;

    private ContentSettings? _settings;
    private string _timeZoneId = string.Empty;
    private string _generationTime = string.Empty;
    private string _publishTime = string.Empty;
    private int _publishWindow;
    private int _audioRetentionDays;
    private string? _scheduleError;
    private string? _scheduleSaved;

    // The WordPress site editor (§8.1). Kept as strings because that is what an <input> binds to; the use case turns
    // blank into "stop overriding this field".
    private string _siteTargetId = string.Empty;
    private string _siteBaseUrl = string.Empty;
    private string _siteUsername = string.Empty;
    private string _siteSecretName = string.Empty;
    private int? _siteTimeoutSeconds;
    private WordPressSiteDto? _siteEffective;
    private string? _siteError;
    private string? _siteSaved;
    private bool _siteBusy;

    private ILogger Logger => LoggerFactory.CreateLogger("DailyMusings.Admin.Publishing");

    protected override async Task OnInitializedAsync()
    {
        _error = await AdminOperation.RunAsync(
            async () =>
            {
                await LoadAsync();
                await LoadSettingsAsync();

                // Default the site editor to the first WordPress target, so the section is useful on arrival rather
                // than empty until the operator picks something.
                _siteTargetId = _targets?
                    .FirstOrDefault(target => target.Type == PublishTargetType.WordPress)?
                    .Id.ToString() ?? string.Empty;

                if (!string.IsNullOrEmpty(_siteTargetId))
                {
                    await LoadSiteAsync();
                }
            },
            Logger);
    }

    private async Task LoadAsync()
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        _targets = await scope.ServiceProvider
            .GetRequiredService<ListPublishTargetsUseCase>()
            .ExecuteAsync(CancellationToken.None);
    }

    private async Task LoadSettingsAsync()
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        _settings = await scope.ServiceProvider
            .GetRequiredService<IContentSettingsProvider>()
            .GetAsync(CancellationToken.None);

        _timeZoneId = _settings.TimeZoneId;
        _generationTime = ContentSettings.FormatTime(_settings.GenerationLocalTime);
        _publishTime = ContentSettings.FormatTime(_settings.PublishLocalTime);
        _publishWindow = _settings.PublishWindowMinutes;
        _audioRetentionDays = _settings.AudioRetentionDays;
    }

    /// <summary>
    /// Parses the two times here rather than in the use case, so a typo is reported next to the field that has it.
    /// The use case validates everything else — the time zone above all, since a bad zone id would otherwise only
    /// surface when a capture failed.
    /// </summary>
    private async Task SaveSettingsAsync()
    {
        _busy = true;
        _scheduleError = null;
        _scheduleSaved = null;

        try
        {
            if (!TimeOnly.TryParseExact(_generationTime, "HH:mm", CultureInfo.InvariantCulture, DateTimeStyles.None, out var generation) ||
                !TimeOnly.TryParseExact(_publishTime, "HH:mm", CultureInfo.InvariantCulture, DateTimeStyles.None, out var publish))
            {
                _scheduleError = "时刻需要写成 HH:mm，例如 23:00。";
                return;
            }

            ContentSettings? saved = null;

            var failure = await AdminOperation.RunAsync(
                async () =>
                {
                    await using var scope = ScopeFactory.CreateAsyncScope();
                    saved = await scope.ServiceProvider
                        .GetRequiredService<UpdateContentSettingsUseCase>()
                        .ExecuteAsync(
                            new ContentSettingsUpdate(_timeZoneId, generation, publish, _publishWindow, _audioRetentionDays),
                            CancellationToken.None);
                },
                Logger);

            if (failure is not null)
            {
                _scheduleError = failure;
                return;
            }

            if (saved is not null)
            {
                _settings = saved;
                _scheduleSaved = $"时区 {saved.TimeZoneId}，生成 {ContentSettings.FormatTime(saved.GenerationLocalTime)}，"
                    + $"发布 {ContentSettings.FormatTime(saved.PublishLocalTime)}，窗口 {saved.PublishWindowMinutes} 分钟。";
            }
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Starts the confirmation for either direction. Both need the password, because the use case requires it to
    /// turn the switch off as well — and the previous version rendered the password box only on the way in, so
    /// "关闭自动公开" always submitted an empty password, could never succeed, and left the opt-in impossible to
    /// revoke from the UI.
    /// </summary>
    private void BeginConfirm(PublishTarget target, bool enable)
    {
        _confirming = target.Id;
        _confirmActionIsEnable = enable;
        _password = string.Empty;
        _error = null;
        _enabled = null;
        _disabled = null;
    }

    private void CancelConfirm()
    {
        _confirming = null;
        _password = string.Empty;
    }

    private async Task CreateAsync()
    {
        _busy = true;
        _error = null;

        try
        {
            // Checked here as well as inside the use case: the use case rejects a blank name with ArgumentException,
            // which is not an operator-facing failure type, and an exception escaping an @onclick handler kills the
            // whole circuit — one empty click and every button on this page stops responding.
            if (string.IsNullOrWhiteSpace(_newName))
            {
                _error = "名称不能为空。";
                return;
            }

            var type = _newType == "markdown" ? PublishTargetType.Markdown : PublishTargetType.WordPress;
            var name = _newName;
            var destination = string.IsNullOrWhiteSpace(_newDestination) ? null : _newDestination;

            var failure = await AdminOperation.RunAsync(
                async () =>
                {
                    await using var scope = ScopeFactory.CreateAsyncScope();
                    await scope.ServiceProvider
                        .GetRequiredService<CreatePublishTargetUseCase>()
                        .ExecuteAsync(name, type, destination, CancellationToken.None);
                },
                Logger);

            if (failure is not null)
            {
                _error = failure;
                return;
            }

            _newName = string.Empty;
            _newDestination = string.Empty;
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Applies the confirmed direction. One path for both directions, so the password requirement and the error
    /// reporting cannot drift apart the way they did when only the enable path had a password box.
    /// </summary>
    private async Task ApplyConfirmAsync(PublishTarget target)
    {
        _busy = true;
        _error = null;

        try
        {
            var enable = _confirmActionIsEnable;
            PublishTarget? updated = null;

            var failure = await AdminOperation.RunAsync(
                async () =>
                {
                    await using var scope = ScopeFactory.CreateAsyncScope();
                    updated = await scope.ServiceProvider
                        .GetRequiredService<SetAutomaticPublishUseCase>()
                        .ExecuteAsync(target.Id, enable, _password, CancellationToken.None);
                },
                Logger);

            if (failure is not null)
            {
                // §11.1: a rejected password matters more than a generic failure here — the operator has to know
                // that the switch is still in its previous position.
                _error = failure;
                return;
            }

            _confirming = null;
            _password = string.Empty;

            if (enable)
            {
                _enabled = updated;
            }
            else
            {
                _disabled = target.Name;
            }

            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Loads the selected target's site settings: the stored override (to populate the fields) and the values that
    /// will actually be used (to show what the operator is really getting, since a field can come from either layer).
    /// </summary>
    private async Task LoadSiteAsync()
    {
        _siteError = null;
        _siteSaved = null;

        if (_targets is null || !Guid.TryParse(_siteTargetId, out var parsed))
        {
            return;
        }

        var targetId = new PublishTargetId(parsed);

        var failure = await AdminOperation.RunAsync(
            async () =>
            {
                var target = _targets.FirstOrDefault(candidate => candidate.Id == targetId);
                if (target is null)
                {
                    return;
                }

                await using var scope = ScopeFactory.CreateAsyncScope();
                var services = scope.ServiceProvider;

                var overrides = await services
                    .GetRequiredService<IWordPressSiteOverrideStore>()
                    .GetAsync(targetId, CancellationToken.None);

                var destination = await services
                    .GetRequiredService<IPublishDestinationProvider>()
                    .ResolveAsync(target, CancellationToken.None);

                var site = destination.RequireWordPress();

                _siteBaseUrl = overrides.BaseUrl ?? string.Empty;
                _siteUsername = overrides.Username ?? string.Empty;
                _siteSecretName = overrides.SecretName ?? string.Empty;
                _siteTimeoutSeconds = overrides.TimeoutSeconds;

                _siteEffective = new WordPressSiteDto(
                    !overrides.IsEmpty,
                    overrides.BaseUrl,
                    overrides.Username,
                    overrides.SecretName,
                    overrides.TimeoutSeconds,
                    site.BaseUrl,
                    site.Username,
                    site.SecretName,
                    (int)site.Timeout.TotalSeconds);
            },
            Logger);

        if (failure is not null)
        {
            _siteError = failure;
        }
    }

    private async Task SaveSiteAsync()
    {
        _siteBusy = true;
        _siteError = null;
        _siteSaved = null;

        try
        {
            if (!Guid.TryParse(_siteTargetId, out var parsed))
            {
                _siteError = "请先选择一个 WordPress 目标。";
                return;
            }

            var targetId = new PublishTargetId(parsed);

            var failure = await AdminOperation.RunAsync(
                async () =>
                {
                    await using var scope = ScopeFactory.CreateAsyncScope();
                    await scope.ServiceProvider
                        .GetRequiredService<UpdateWordPressSiteOverrideUseCase>()
                        .ExecuteAsync(
                            targetId,
                            new WordPressSiteOverride(
                                _siteBaseUrl,
                                _siteUsername,
                                _siteSecretName,
                                _siteTimeoutSeconds),
                            CancellationToken.None);
                },
                Logger);

            if (failure is not null)
            {
                _siteError = failure;
                return;
            }

            await LoadSiteAsync();
            _siteSaved = "已保存。下一次发布与「测试连接」都会使用这些值。";
        }
        finally
        {
            _siteBusy = false;
        }
    }

    private async Task ClearSiteAsync()
    {
        _siteBusy = true;
        _siteError = null;
        _siteSaved = null;

        try
        {
            if (!Guid.TryParse(_siteTargetId, out var parsed))
            {
                _siteError = "请先选择一个 WordPress 目标。";
                return;
            }

            var targetId = new PublishTargetId(parsed);

            var failure = await AdminOperation.RunAsync(
                async () =>
                {
                    await using var scope = ScopeFactory.CreateAsyncScope();
                    await scope.ServiceProvider
                        .GetRequiredService<UpdateWordPressSiteOverrideUseCase>()
                        .ExecuteAsync(targetId, WordPressSiteOverride.None, CancellationToken.None);
                },
                Logger);

            if (failure is not null)
            {
                _siteError = failure;
                return;
            }

            await LoadSiteAsync();
            _siteSaved = "已清除覆盖，该目标回到部署配置里的站点设置。";
        }
        finally
        {
            _siteBusy = false;
        }
    }
}
