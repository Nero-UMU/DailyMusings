@page "/devices"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IServiceScopeFactory ScopeFactory
@inject IJSRuntime Js
@inject ILoggerFactory LoggerFactory

@* 设备分区：配对码、已连接设备、已撤销设备。配对码从状态页搬到了这里 —— 它属于「设备」这件事。 *@

<PageHeader Title="设备"
            Hint="连接手机，管理已配对的设备。">
    <Actions>
        <button class="btn btn-primary" @onclick="IssueCodeAsync" disabled="@(_busy || _issuingCode)">
            @(_issuingCode ? "正在签发…" : "生成配对码")
        </button>
    </Actions>
</PageHeader>

@if (_message is not null)
{
    <p class="notice ok">@_message</p>
}

@if (_error is not null)
{
    <p class="notice error">@_error</p>
}

@if (_code is { } code)
{
    <div class="card">
        <div class="card-head">
            <h2>配对码</h2>
            <span class="badge badge-warn">10 分钟内有效 · 只能用一次</span>
        </div>

        <p class="code code-lg">@(code.Code)</p>

        <p class="hint">
            在手机设置页输入配对码。有效期至 @AdminFormat.When(code.ExpiresAtUtc)；关闭此页后无法再次查看。
        </p>

        <div class="actions">
            <button class="btn" @onclick="() => CopyAsync(code.Code)">复制配对码</button>
            <button class="btn" @onclick="DismissCode">收起</button>
        </div>
    </div>
}

@if (_rotated is { } rotated)
{
    <div class="notice ok">
        <strong>新令牌已经签发，旧令牌立即失效。</strong>
        <p class="code code-md">@rotated.Token</p>
        <p>
            请立即保存新令牌；离开页面后无法再次查看。
        </p>
        <div class="actions">
            <button class="btn" @onclick="() => CopyAsync(rotated.Token)">复制令牌</button>
            <button class="btn" @onclick="DismissToken">我已保存，收起</button>
        </div>
    </div>
}

@if (_devices is null)
{
    <p class="muted">正在读取…</p>
}
else if (_devices.Count == 0)
{
    <div class="card">
        <p>还没有设备。生成配对码后，在手机设置页输入。</p>
    </div>
}
else
{
    @foreach (var group in Groups())
    {
        <div class="card-head">
            <h2>@group.Title（@group.Items.Count）</h2>
            <span class="hint">@group.Hint</span>
        </div>

        @if (group.Items.Count == 0)
        {
            <p class="notice info">这一组目前没有设备。</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>名称</th>
                            <th>平台</th>
                            <th>创建时间（本地）</th>
                            <th>最后在线（本地）</th>
                            <th>状态</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var device in group.Items)
                        {
                            <tr>
                                <td><strong>@device.Name</strong></td>
                                <td>@(string.IsNullOrWhiteSpace(device.Platform) ? "—" : device.Platform)</td>
                                <td class="nowrap">@AdminFormat.When(device.CreatedAtUtc)</td>
                                <td class="nowrap">@AdminFormat.When(device.LastSeenAtUtc)</td>
                                <td>
                                    @if (device.IsRevoked)
                                    {
                                        <span class="badge badge-muted">已撤销</span>
                                        <div class="hint">撤销于 @AdminFormat.When(device.RevokedAtUtc)</div>
                                    }
                                    else
                                    {
                                        <span class="badge badge-ok">已连接</span>
                                    }
                                </td>
                                <td>
                                    @if (_confirming == device.Id)
                                    {
                                        <div class="stack">
                                            @if (_confirmDelete)
                                            {
                                                <span class="hint">
                                                    删除这台设备的记录后无法恢复。再次使用需重新配对。
                                                </span>
                                                <div class="actions">
                                                    <button class="btn-danger btn-sm"
                                                            @onclick="() => DeleteAsync(device.Id)"
                                                            disabled="@_busy">
                                                        确认删除这条记录
                                                    </button>
                                                    <button class="btn btn-sm" @onclick="CancelConfirm" disabled="@_busy">取消</button>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="hint">
                                                    撤回后，这台设备需要重新配对才能上传。其他设备不受影响。
                                                </span>
                                                <div class="actions">
                                                    <button class="btn-danger btn-sm"
                                                            @onclick="() => RevokeAsync(device.Id)"
                                                            disabled="@_busy">
                                                        确认撤回授权
                                                    </button>
                                                    <button class="btn btn-sm" @onclick="CancelConfirm" disabled="@_busy">取消</button>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else if (device.IsRevoked)
                                    {
                                        <div class="actions">
                                            <button class="btn btn-sm"
                                                    @onclick="() => BeginConfirm(device.Id, delete: true)"
                                                    disabled="@_busy">
                                                从列表移除…
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="actions">
                                            <button class="btn btn-sm"
                                                    @onclick="() => BeginRotate(device.Id)"
                                                    disabled="@_busy">
                                                更换设备令牌…
                                            </button>
                                            <button class="btn btn-sm"
                                                    @onclick="() => BeginConfirm(device.Id, delete: false)"
                                                    disabled="@_busy">
                                                撤回授权…
                                            </button>
                                        </div>

                                        @if (_confirmingRotate == device.Id)
                                        {
                                            <div class="risk">
                                                <strong>更换令牌会让旧令牌立刻失效。</strong>
                                                <p>
                                                    新令牌只显示一次，必须马上填进客户端；如果填丢了，只能再轮换一次。
                                                </p>
                                                <div class="actions">
                                                    <button class="btn-danger btn-sm"
                                                            @onclick="() => RotateAsync(device.Id)"
                                                            disabled="@_busy">
                                                        确认更换
                                                    </button>
                                                    <button class="btn btn-sm" @onclick="CancelConfirm" disabled="@_busy">取消</button>
                                                </div>
                                            </div>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
}

@code {
    private IReadOnlyList<Device>? _devices;
    private IssuedPairingCode? _code;
    private RotatedDeviceToken? _rotated;
    private string? _message;
    private string? _error;
    private bool _busy;
    private bool _issuingCode;

    /// <summary>Which device a destructive action is about to happen to, so it takes two clicks.</summary>
    private DeviceId? _confirming;

    /// <summary>Whether <see cref="_confirming"/> is the 「从列表移除」 path rather than 「撤回授权」.</summary>
    private bool _confirmDelete;

    private DeviceId? _confirmingRotate;

    private ILogger Logger => LoggerFactory.CreateLogger("DailyMusings.Admin.Devices");

    protected override async Task OnInitializedAsync()
    {
        // Guarded as well: an unguarded first load terminated the circuit when the database was momentarily
        // unavailable, and the page stayed on「正在读取…」for ever.
        _error = await AdminOperation.RunAsync(LoadAsync, Logger);
    }

    private IReadOnlyList<(string Title, string Hint, IReadOnlyList<Device> Items)> Groups()
    {
        var devices = _devices ?? [];

        return
        [
            (
                "已连接",
                "这些设备的令牌当前有效，可以继续采集。",
                devices.Where(device => !device.IsRevoked).ToArray()),
            (
                "已撤销",
                "令牌已经失效，设备无法再访问实例；重新配对即可恢复。",
                devices.Where(device => device.IsRevoked).ToArray()),
        ];
    }

    private async Task LoadAsync()
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        _devices = await scope.ServiceProvider
            .GetRequiredService<ListDevicesUseCase>()
            .ExecuteAsync(CancellationToken.None);
    }

    private async Task IssueCodeAsync()
    {
        _issuingCode = true;
        _message = null;
        _error = null;

        try
        {
            // Every handler body goes through the guard: an exception escaping an @onclick handler terminates the
            // circuit, and from then on every button on the page is dead — which an operator reports as
            // 「生成配对码 点不了」, not as an error.
            var failure = await AdminOperation.RunAsync(
                async () =>
                {
                    await using var scope = ScopeFactory.CreateAsyncScope();
                    _code = await scope.ServiceProvider
                        .GetRequiredService<IssuePairingCodeUseCase>()
                        .ExecuteAsync(CancellationToken.None);

                    _rotated = null;
                },
                Logger);

            if (failure is not null)
            {
                _error = failure;
            }
        }
        finally
        {
            _issuingCode = false;
        }
    }

    private void BeginRotate(DeviceId deviceId)
    {
        _message = null;
        _error = null;
        _rotated = null;
        _confirming = null;
        _confirmingRotate = deviceId;
    }

    private void BeginConfirm(DeviceId deviceId, bool delete)
    {
        _message = null;
        _error = null;
        _rotated = null;
        _confirmingRotate = null;
        _confirming = deviceId;
        _confirmDelete = delete;
    }

    private void CancelConfirm()
    {
        _confirming = null;
        _confirmDelete = false;
        _confirmingRotate = null;
    }

    private void DismissCode() => _code = null;

    private void DismissToken() => _rotated = null;

    private async Task RevokeAsync(DeviceId deviceId)
    {
        _busy = true;
        _error = null;
        _message = null;

        try
        {
            var failure = await AdminOperation.RunAsync(
                async () =>
                {
                    await using var scope = ScopeFactory.CreateAsyncScope();
                    await scope.ServiceProvider
                        .GetRequiredService<RevokeDeviceUseCase>()
                        .ExecuteAsync(deviceId, CancellationToken.None);

                    await LoadAsync();
                },
                Logger);

            if (failure is not null)
            {
                _error = failure;
                return;
            }

            _confirming = null;
            _message = "已撤回该设备的授权，它的令牌立刻失效。";
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// 「删除已撤销的设备」：真正把设备行删掉。
    /// <para>
    /// 与「撤回授权」是两件事，而且服务端也分成两条路由：撤回是安全动作（对一台还在用的设备，立刻失效），
    /// 删除是清理动作（只对已撤销的设备，把死掉的令牌哈希从库里去掉）。这样分开，操作者不会在没打算
    /// 切断某台设备的时候顺手把它删掉。
    /// </para>
    /// </summary>
    private async Task DeleteAsync(DeviceId deviceId)
    {
        _busy = true;
        _error = null;
        _message = null;

        try
        {
            Device? device = null;

            var failure = await AdminOperation.RunAsync(
                async () =>
                {
                    await using var scope = ScopeFactory.CreateAsyncScope();
                    device = _devices?.FirstOrDefault(item => item.Id == deviceId);

                    await scope.ServiceProvider
                        .GetRequiredService<DeleteDeviceUseCase>()
                        .ExecuteAsync(deviceId, CancellationToken.None);

                    await LoadAsync();
                },
                Logger);

            if (failure is not null)
            {
                _error = failure;
                return;
            }

            _confirming = null;
            _message = $"已删除「{device?.Name ?? deviceId.ToString()}」的设备记录，它的令牌哈希不再留在库里。";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RotateAsync(DeviceId deviceId)
    {
        _busy = true;
        _error = null;
        _message = null;

        try
        {
            var failure = await AdminOperation.RunAsync(
                async () =>
                {
                    await using var scope = ScopeFactory.CreateAsyncScope();
                    _rotated = await scope.ServiceProvider
                        .GetRequiredService<RotateDeviceTokenUseCase>()
                        .ExecuteAsync(deviceId, CancellationToken.None);

                    await LoadAsync();
                },
                Logger);

            if (failure is not null)
            {
                _error = failure;
                return;
            }

            _confirmingRotate = null;
            _message = "已更换令牌：新令牌见下方，旧令牌立刻失效。";
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// 复制到剪贴板。走 <c>window.dmCopy</c>（Admin 项目的 <c>admin-copy.js</c>）：它先试
    /// <c>navigator.clipboard</c>，失败再退回 <c>document.execCommand('copy')</c>。
    /// <para>
    /// 这里此前只走 <c>navigator.clipboard</c>，于是明文 HTTP 下（本实例的默认形态：局域网、VPN）
    /// 那个对象是 <c>undefined</c>，按钮**必然**失败，页面还把结果说成「浏览器没有允许自动复制」。
    /// 实测过：同一个明文页面上 <c>document.execCommand('copy')</c> 返回 true 且内容真的进了剪贴板，
    /// 所以那不是浏览器做不到，只是没写兜底。禁用自动复制也没有换来安全 —— 这串码在明文 HTTP 上
    /// 本来就在网络里裸传，而且照样显示在页面上，手动选中一样能复制。
    /// </para>
    /// </summary>
    private async Task CopyAsync(string value)
    {
        _message = null;
        _error = null;

        var outcome = new CopyOutcome();
        var failure = await AdminOperation.RunAsync(
            async () =>
            {
                outcome = await Js.InvokeAsync<CopyOutcome>("dmCopy", value);
            },
            Logger);

        if (failure is not null)
        {
            _error = failure;
            return;
        }

        if (outcome.Ok)
        {
            _message = outcome.Secure
                ? "已复制到剪贴板。"
                : "已复制到剪贴板。当前是明文 HTTP 连接，这串码在传输途中可能被看到。";
            return;
        }

        // 两条路都失败（浏览器策略、权限被拒、页面失焦）：这时才让人手动选中。
        _message = "浏览器不允许自动复制。请在上面的框里手动选中后复制。";
    }

    /// <summary><c>dmCopy</c> 的返回值，字段名与 JS 里返回的对象对应。</summary>
    private sealed class CopyOutcome
    {
        public bool Ok { get; set; }

        public bool Secure { get; set; }

        public string? How { get; set; }
    }
}
