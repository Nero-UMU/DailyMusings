@page "/settings"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IServiceScopeFactory ScopeFactory
@inject IRuntimeOverridesStore Overrides
@inject IServer Server
@inject ILoggerFactory LoggerFactory
@using System.Globalization

@* The component class must not be called InstanceSettings: that name is taken by the Application record this page
   edits, and the component's own class would shadow it inside this file. *@

<h1>实例设置</h1>

<p class="hint">
    这里的每一项都写在实例的设置表里，<strong>保存后立即生效，不需要重启</strong>。读取顺序是
    「本页保存的值 → 部署配置（.env / compose）→ 内置默认」，所以本页留过的值优先。
</p>

@if (_error is not null)
{
    <p class="notice error">@_error</p>
}

@if (_saved is not null)
{
    <p class="notice ok">@_saved</p>
}

<h2>监听端口</h2>

<p class="hint">
    当前这个页面是通过 <code>@_effectivePort</code> 端口打开的。端口是唯一一项<strong>不能</strong>存在设置表里的配置：
    它决定设置接口本身在哪个端口上，所以只能写在磁盘上的一个文件里，由下次启动读取。
</p>

<div class="summary">
    <div class="summary-item">
        <span class="label">当前生效端口</span>
        <span class="value">@_effectivePort</span>
    </div>
    <div class="summary-item">
        <span class="label">已保存的覆盖值</span>
        <span class="value">
            @if (_port is null)
            {
                <span class="muted">未设置</span>
            }
            else
            {
                @_port
            }
        </span>
    </div>
    <div class="summary-item">
        <span class="label">状态</span>
        <span class="value">
            @if (_port is null)
            {
                <span class="badge badge-muted">沿用部署配置 @_configuredPort</span>
            }
            else if (_port == _effectivePort)
            {
                <span class="badge badge-ok">已生效</span>
            }
            else
            {
                <span class="badge badge-warn">待重启生效</span>
            }
        </span>
    </div>
</div>

<p class="hint">
    覆盖文件：<code>@Overrides.ConfigPath</code>
</p>

<div class="form-grid">
    <label>
        端口（1024–65535）
        <input type="number" min="1024" max="65535" @bind="_portInput" placeholder="18321" />
    </label>
</div>

<div class="actions">
    <button class="btn-primary" @onclick="SavePortAsync" disabled="@_busy">保存端口</button>
    <button @onclick="ClearPortAsync" disabled="@_busy">清除覆盖</button>
</div>

@if (_port is not null && _port != _effectivePort)
{
    <div class="risk">
        <strong>端口改动需要两步才会生效。</strong>
        <p>
            容器的端口映射在<strong>容器启动时</strong>就固定了，所以后台只能保存值。请按下面两步做完，
            否则映射会指向一个没人监听的端口（那时容器健康检查仍会通过，但外部连不上）：
        </p>
        <ol>
            <li>
                在 <code>deploy/.env</code> 里把内部端口改成同一个值：
                <br />
                <code class="code">DAILYMUSINGS_INTERNAL_PORT=@_port</code>
            </li>
            <li>
                重建容器：
                <br />
                <code class="code">docker compose -f deploy/compose.yaml up -d --force-recreate</code>
            </li>
        </ol>
        <p>
            万一新端口用不了、页面再也打不开，用这个环境变量忽略覆盖文件（或在宿主机上删掉
            <code>@Overrides.ConfigPath</code>）：
            <br />
            <code class="code">DAILYMUSINGS_IGNORE_RUNTIME_OVERRIDES=1</code>
        </p>
    </div>
}

<h2>调度</h2>

<div class="form-grid">
    <label>
        轮询间隔（秒）
        <input type="number" @bind="_schedulerInterval" />
    </label>
    <label>
        补跑窗口（天）
        <input type="number" @bind="_schedulerBackfill" />
    </label>
    <label>
        每次调度的生成上限
        <input type="number" @bind="_schedulerBatch" />
    </label>
</div>

<p class="hint">
    补跑窗口决定停机或离线后最多往前找多少天有待生成素材的日期；生成上限决定一次调度最多把几天放进队列，
    避免长时间停机后一次性打出一串模型调用。
</p>

<h2>维护与备份</h2>

<div class="form-grid">
    <label>
        备份时刻（HH:mm，内容时区）
        <input @bind="_backupTime" placeholder="03:30" />
    </label>
    <label>
        音频清理时刻（HH:mm，内容时区）
        <input @bind="_cleanupTime" placeholder="04:00" />
    </label>
    <label>
        备份保留份数
        <input type="number" @bind="_backupKeepCount" />
    </label>
</div>

<label class="checkbox">
    <input type="checkbox" @bind="_backupEnabled" />
    每晚自动备份
</label>

<p class="hint">
    这两个时刻<strong>不再受「是否配置了模型端点」影响</strong>：即使模型没配好，备份与清理也照常按时刻执行。
</p>

<h2>历史检索</h2>

<div class="form-grid">
    <label>
        最多返回材料条数
        <input type="number" @bind="_maxMaterials" />
    </label>
    <label>
        候选扫描上限
        <input type="number" @bind="_candidateScanLimit" />
    </label>
    <label>
        相关性下限（0–1）
        <input type="number" step="0.01" @bind="_minimumRelevance" />
    </label>
    <label>
        词面匹配下限（0–1）
        <input type="number" step="0.01" @bind="_minimumLexicalScore" />
    </label>
</div>

<p class="hint">
    这几项在 Embedding 未启用时决定历史检索的降级行为，改了立即对下一次检索生效。
</p>

<div class="actions">
    <button class="btn-primary" @onclick="SaveSettingsAsync" disabled="@_busy">保存上述设置</button>
</div>

@code {
    /// <summary>The port the deployment ships with, shown when the environment says nothing.</summary>
    private const int FallbackPort = 18321;

    private Application.Configuration.InstanceSettings? _settings;
    private int? _port;
    private int _effectivePort;
    private int _configuredPort;
    private string _portInput = string.Empty;
    private string? _error;
    private string? _saved;
    private bool _busy;

    private int _schedulerInterval;
    private int _schedulerBackfill;
    private int _schedulerBatch;
    private bool _backupEnabled;
    private string _backupTime = string.Empty;
    private string _cleanupTime = string.Empty;
    private int _backupKeepCount;
    private int _maxMaterials;
    private int _candidateScanLimit;
    private double _minimumRelevance;
    private double _minimumLexicalScore;

    private ILogger Logger => LoggerFactory.CreateLogger("DailyMusings.Admin.InstanceSettings");

    protected override async Task OnInitializedAsync()
    {
        _error = await AdminOperation.RunAsync(LoadAsync, Logger);
    }

    private async Task LoadAsync()
    {
        await using var scope = ScopeFactory.CreateAsyncScope();

        _settings = await scope.ServiceProvider
            .GetRequiredService<IInstanceSettingsProvider>()
            .GetAsync(CancellationToken.None);

        _configuredPort = ReadConfiguredPort();

        var current = Overrides.Read();
        _port = current.ListeningPort;
        _portInput = current.ListeningPort?.ToString(CultureInfo.InvariantCulture) ?? string.Empty;

        // The address the host is actually bound to. This is the closest thing to "the port in use" available from
        // inside a circuit: HttpContext is long gone by the time an interactive page renders.
        _effectivePort = ReadBoundPort() ?? _configuredPort;

        ApplyToFields(_settings);
    }

    private void ApplyToFields(Application.Configuration.InstanceSettings settings)
    {
        _schedulerInterval = settings.SchedulerIntervalSeconds;
        _schedulerBackfill = settings.SchedulerBackfillWindowDays;
        _schedulerBatch = settings.SchedulerMaxGenerationsPerTick;
        _backupEnabled = settings.BackupEnabled;
        _backupTime = ContentSettings.FormatTime(settings.BackupLocalTime);
        _cleanupTime = ContentSettings.FormatTime(settings.AudioCleanupLocalTime);
        _backupKeepCount = settings.BackupKeepCount;
        _maxMaterials = settings.RetrievalMaxMaterials;
        _candidateScanLimit = settings.RetrievalCandidateScanLimit;
        _minimumRelevance = settings.RetrievalMinimumRelevance;
        _minimumLexicalScore = settings.RetrievalMinimumLexicalScore;
    }

    /// <summary>What the deployment says, which is what applies when there is no override on disk.</summary>
    private static int ReadConfiguredPort() =>
        ParsePortFromUrl(Environment.GetEnvironmentVariable("ASPNETCORE_URLS")) ?? FallbackPort;

    private int? ReadBoundPort()
    {
        var addresses = Server.Features.Get<IServerAddressesFeature>()?.Addresses;

        if (addresses is null)
        {
            return null;
        }

        foreach (var address in addresses)
        {
            if (ParsePortFromUrl(address) is { } port)
            {
                return port;
            }
        }

        return null;
    }

    /// <summary>Takes the port out of <c>http://host:port</c>, tolerating the <c>+</c> / IPv6-in-brackets forms.</summary>
    private static int? ParsePortFromUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
        {
            return null;
        }

        var separator = url.LastIndexOf(':');

        return separator >= 0 &&
               int.TryParse(
                   url[(separator + 1)..].TrimEnd('/'),
                   NumberStyles.Integer,
                   CultureInfo.InvariantCulture,
                   out var port)
            ? port
            : null;
    }

    private async Task SavePortAsync()
    {
        _busy = true;
        _error = null;
        _saved = null;

        try
        {
            if (!int.TryParse(_portInput, NumberStyles.Integer, CultureInfo.InvariantCulture, out var port))
            {
                _error = "端口需要是一个数字。";
                return;
            }

            var failure = await AdminOperation.RunAsync(
                () =>
                {
                    Overrides.Write(port, "admin", DateTimeOffset.UtcNow);
                    return Task.CompletedTask;
                },
                Logger);

            if (failure is not null)
            {
                _error = failure;
                return;
            }

            await LoadAsync();
            _saved = $"已保存端口 {port}。重启容器后生效，步骤见上方说明。";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ClearPortAsync()
    {
        _busy = true;
        _error = null;
        _saved = null;

        try
        {
            var failure = await AdminOperation.RunAsync(
                () =>
                {
                    // Null clears the override, so the instance goes back to whatever the deployment says.
                    Overrides.Write(null, "admin", DateTimeOffset.UtcNow);
                    return Task.CompletedTask;
                },
                Logger);

            if (failure is not null)
            {
                _error = failure;
                return;
            }

            await LoadAsync();
            _saved = "已清除端口覆盖，重启容器后回到部署配置里的端口。";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveSettingsAsync()
    {
        _busy = true;
        _error = null;
        _saved = null;

        try
        {
            // Parsed here so a typo is reported next to the field. The use case validates the whole set and writes it
            // in one transaction, so a rejected value cannot leave half of it applied.
            if (!TimeOnly.TryParseExact(_backupTime, "HH:mm", CultureInfo.InvariantCulture, DateTimeStyles.None, out var backupTime) ||
                !TimeOnly.TryParseExact(_cleanupTime, "HH:mm", CultureInfo.InvariantCulture, DateTimeStyles.None, out var cleanupTime))
            {
                _error = "两个时刻都需要写成 HH:mm，例如 03:30。";
                return;
            }

            Application.Configuration.InstanceSettings? saved = null;

            var failure = await AdminOperation.RunAsync(
                async () =>
                {
                    await using var scope = ScopeFactory.CreateAsyncScope();
                    saved = await scope.ServiceProvider
                        .GetRequiredService<UpdateInstanceSettingsUseCase>()
                        .ExecuteAsync(
                            new InstanceSettingsUpdate(
                                _schedulerInterval,
                                _schedulerBackfill,
                                _schedulerBatch,
                                _backupEnabled,
                                backupTime,
                                cleanupTime,
                                _backupKeepCount,
                                _maxMaterials,
                                _candidateScanLimit,
                                _minimumRelevance,
                                _minimumLexicalScore),
                            CancellationToken.None);
                },
                Logger);

            if (failure is not null)
            {
                _error = failure;
                return;
            }

            if (saved is not null)
            {
                _settings = saved;
                ApplyToFields(saved);
            }

            _saved = "已保存，下一次调度与备份即按新值执行。";
        }
        finally
        {
            _busy = false;
        }
    }
}
