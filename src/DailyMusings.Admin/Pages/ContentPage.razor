@page "/content"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IServiceScopeFactory ScopeFactory
@inject ILoggerFactory LoggerFactory

<PageHeader Title="内容管理" Hint="查看稿件、主题和发布状态。">
    <Actions><button class="btn" @onclick="ReloadAsync" disabled="@_busy">刷新</button></Actions>
</PageHeader>

@if (_message is not null) { <p class="notice ok">@_message</p> }
@if (_error is not null) { <p class="notice error">@_error</p> }

<section class="library-summary">
    <div><strong>@_articles.Count</strong><span>全部稿件</span></div>
    <div><strong>@_articles.Count(IsPublished)</strong><span>已发布</span></div>
    <div><strong>@_articles.Count(article => !IsPublished(article))</strong><span>未发布</span></div>
    <div><strong>@_topics.Count</strong><span>主题</span></div>
</section>

<section class="card library-card">
    <div class="library-toolbar">
        <div class="segmented" role="group" aria-label="稿件状态筛选">
            <button class="@FilterClass(FilterAll)" @onclick="() => SetFilter(FilterAll)">全部</button>
            <button class="@FilterClass(FilterDraft)" @onclick="() => SetFilter(FilterDraft)">未发布</button>
            <button class="@FilterClass(FilterPublished)" @onclick="() => SetFilter(FilterPublished)">已发布</button>
        </div>
        <input class="library-search" placeholder="搜索标题、摘要或日期" value="@_search" @oninput="e => _search = (string?)e.Value ?? string.Empty" />
    </div>

    @if (VisibleArticles().Count == 0)
    {
        <p class="empty-state">没有符合条件的稿件。</p>
    }
    else
    {
        <div class="article-grid">
            @foreach (var article in VisibleArticles())
            {
                var version = article.WorkingVersion;
                <article class="article-card @(article.Id == _selected?.Id ? "selected" : "")">
                    <button class="article-open" @onclick="() => OpenArticle(article)">
                        <span class="article-date">@article.ContentDate</span>
                        <h2>@(string.IsNullOrWhiteSpace(version?.Title) ? "（无标题）" : version.Title)</h2>
                        <p>@(string.IsNullOrWhiteSpace(version?.Summary) ? Preview(version?.Body) : version.Summary)</p>
                    </button>
                    <div class="article-meta">
                        <span class="badge @(IsPublished(article) ? "badge-ok" : "badge-warn")">@(IsPublished(article) ? "已发布" : "未发布")</span>
                        @foreach (var topic in version?.Topics ?? [])
                        {
                            <span class="topic-chip">@topic.Name</span>
                        }
                        @if (CanContinuePublish(article))
                        {
                            <button class="btn btn-sm" @onclick="() => BeginContinuePublication(article)">继续发布</button>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>

@if (_selected is { } selected)
{
    <section class="card reader-card">
        <div class="card-head">
            <div><span class="eyebrow">@selected.ContentDate · @(IsPublished(selected) ? "已发布" : "未发布")</span>
                <h2>@(string.IsNullOrWhiteSpace(selected.WorkingVersion?.Title) ? "（无标题）" : selected.WorkingVersion.Title)</h2></div>
            <button class="btn btn-sm" @onclick="CloseArticle">收起</button>
        </div>

        @if (selected.WorkingVersion is { } current)
        {
            <article class="reader-document">
                @if (!string.IsNullOrWhiteSpace(current.Summary)) { <p class="article-summary">@current.Summary</p> }
                <div class="article-body">@current.Body</div>
            </article>

            @if (CanContinuePublish(selected))
            {
                <div class="continuation-zone">
                    <div>
                        <strong>继续发布这一天的新稿</strong>
                        <p class="hint">发布后将用当前稿件替换旧稿。若旧文件已在外部修改，将保留旧文件。</p>
                    </div>
                    @if (_confirmContinuePublication == selected.Id)
                    {
                        <div class="actions">
                            <button class="btn-primary" @onclick="ContinuePublicationAsync" disabled="@_busy">确认替换并发布</button>
                            <button class="btn" @onclick="CancelContinuePublication" disabled="@_busy">取消</button>
                        </div>
                    }
                    else
                    {
                        <button class="btn-primary" @onclick="() => _confirmContinuePublication = selected.Id" disabled="@_busy">继续发布…</button>
                    }
                </div>
            }

            <div class="topic-editor">
                <div><h3>稿件主题</h3><p class="hint">可选择一个或多个主题；第一个选中的主题作为主要主题。</p></div>
                @if (_topics.Count == 0)
                {
                    <p class="notice info">还没有主题，请先在下方创建。</p>
                }
                else
                {
                    <div class="topic-picker">
                        @foreach (var item in _topics)
                        {
                            <label class="topic-option">
                                <input type="checkbox" checked="@_selectedTopicIds.Contains(item.Topic.Id)"
                                       @onchange="e => ToggleTopic(item.Topic.Id, e.Value is true)" />
                                <span>@item.Topic.Name</span>
                                <small>@(item.Topic.Origin == TopicOrigin.Model ? "大模型添加" : "用户添加")</small>
                            </label>
                        }
                    </div>
                    <button class="btn-primary" @onclick="SaveArticleTopicsAsync" disabled="@_busy">保存稿件主题</button>
                }
            </div>

            <div class="danger-zone">
                <div><strong>删除这篇稿件</strong><p class="hint">正文、历史版本和发布记录将永久删除，这一天也不会自动重新生成（你手动点「立即生成稿件」仍然可以）。已输出的文件会保留。</p></div>
                @if (_confirmDeleteArticle == selected.Id)
                {
                    <div class="actions"><button class="btn-danger" @onclick="DeleteArticleAsync" disabled="@_busy">确认永久删除</button>
                        <button class="btn" @onclick="CancelArticleDelete" disabled="@_busy">取消</button></div>
                }
                else { <button class="btn-danger" @onclick="() => _confirmDeleteArticle = selected.Id" disabled="@_busy">删除稿件…</button> }
            </div>
        }
    </section>
}

<section class="card topics-card">
    <div class="card-head"><div><span class="eyebrow">主题库</span><h2>主题管理</h2></div></div>
    <div class="topic-create">
        <input placeholder="输入新主题名称" value="@_newTopicName" @oninput="e => _newTopicName = (string?)e.Value ?? string.Empty" />
        <button class="btn-primary" @onclick="CreateTopicAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_newTopicName))">添加主题</button>
    </div>

    <div class="topic-list">
        @foreach (var item in _topics)
        {
            <div class="topic-row">
                <div class="topic-name"><strong>@item.Topic.Name</strong>
                    <span class="badge @(item.Topic.Origin == TopicOrigin.Model ? "badge-warn" : "badge-ok")">@(item.Topic.Origin == TopicOrigin.Model ? "大模型添加" : "用户添加")</span></div>
                <div class="topic-usage"><span>@item.ArticleCount 篇稿件</span><span>@item.InputCount 条素材</span></div>
                <div>
                    @if (_confirmDeleteTopic == item.Topic.Id)
                    {
                        <div class="actions"><button class="btn-danger btn-sm" @onclick="() => DeleteTopicAsync(item.Topic.Id)" disabled="@(_busy || item.ArticleCount > 0)">确认删除</button>
                            <button class="btn btn-sm" @onclick="CancelTopicDelete">取消</button></div>
                    }
                    else
                    {
                        <button class="btn btn-sm" @onclick="() => BeginTopicDelete(item)" disabled="@(_busy || item.ArticleCount > 0)" title="@(item.ArticleCount > 0 ? "仍有稿件使用此主题" : "删除主题")">删除</button>
                    }
                </div>
            </div>
        }
        @if (_topics.Count == 0) { <p class="empty-state">主题库还是空的。</p> }
    </div>
    <p class="hint">正在被稿件使用的主题不能删除。删除主题不会删除随想。</p>
</section>

@code {
    private const string FilterAll = "all";
    private const string FilterDraft = "draft";
    private const string FilterPublished = "published";
    private readonly List<ReflectionView> _articles = [];
    private readonly List<TopicSummary> _topics = [];
    private readonly HashSet<ReflectionVersionId> _publishedVersionIds = [];
    private readonly Dictionary<ReflectionId, PublishTargetId> _publishedTargetsByReflection = [];
    private readonly List<TopicId> _selectedTopicIds = [];
    private ContentDate _today;
    private ReflectionView? _selected;
    private ReflectionId? _confirmDeleteArticle;
    private ReflectionId? _confirmContinuePublication;
    private TopicId? _confirmDeleteTopic;
    private string _filter = FilterAll;
    private string _search = string.Empty;
    private string _newTopicName = string.Empty;
    private bool _busy;
    private string? _message;
    private string? _error;
    private ILogger Logger => LoggerFactory.CreateLogger("DailyMusings.Admin.Content");

    protected override async Task OnInitializedAsync() => _error = await AdminOperation.RunAsync(LoadAsync, Logger);

    private async Task LoadAsync()
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        var services = scope.ServiceProvider;
        var calendar = await services.GetRequiredService<IContentCalendarProvider>().GetCalendarAsync(CancellationToken.None);
        _today = calendar.ContentDateOf(services.GetRequiredService<IClock>().UtcNow);
        var page = await services.GetRequiredService<ListReflectionsUseCase>().ExecuteDetailedPageAsync(
            _today.AddDays(-36500), _today, page: 1, pageSize: 10000, CancellationToken.None);
        _articles.Clear(); _articles.AddRange(page.Items.OrderByDescending(item => item.ContentDate));

        _publishedVersionIds.Clear();
        _publishedTargetsByReflection.Clear();
        var publications = await services.GetRequiredService<ListPublicationsUseCase>().ExecuteAsync(2000, CancellationToken.None);
        foreach (var item in publications.Where(item => item.Publication.Status == PublicationStatus.Published))
        {
            _publishedVersionIds.Add(item.Publication.ReflectionVersionId);
            _publishedTargetsByReflection[item.Publication.ReflectionId] = item.Publication.PublishTargetId;
        }

        _topics.Clear();
        _topics.AddRange(await services.GetRequiredService<ListTopicsWithUsageUseCase>().ExecuteAsync(false, CancellationToken.None));

        if (_selected is not null)
        {
            _selected = _articles.FirstOrDefault(item => item.Id == _selected.Id);
            SyncSelectedTopics();
        }
    }

    private IReadOnlyList<ReflectionView> VisibleArticles()
    {
        var query = _articles.AsEnumerable();
        query = _filter switch
        {
            FilterPublished => query.Where(IsPublished),
            FilterDraft => query.Where(article => !IsPublished(article)),
            _ => query,
        };
        if (!string.IsNullOrWhiteSpace(_search))
        {
            var term = _search.Trim();
            query = query.Where(article =>
                article.ContentDate.ToString().Contains(term, StringComparison.OrdinalIgnoreCase) ||
                (article.WorkingVersion?.Title?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (article.WorkingVersion?.Summary?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false));
        }
        return query.ToArray();
    }

    private bool IsPublished(ReflectionView article) =>
        article.WorkingVersion is { } version && _publishedVersionIds.Contains(version.Id);
    private bool CanContinuePublish(ReflectionView article) =>
        article.ContentDate < _today &&
        article.WorkingVersion is not null &&
        !IsPublished(article) &&
        _publishedTargetsByReflection.ContainsKey(article.Id);
    private static string Preview(string? body) => string.IsNullOrWhiteSpace(body) ? "暂无正文" : body.Length <= 90 ? body : body[..90] + "…";
    private string FilterClass(string value) => _filter == value ? "active" : string.Empty;
    private void SetFilter(string value) => _filter = value;

    private void OpenArticle(ReflectionView article) { _selected = article; _confirmDeleteArticle = null; _confirmContinuePublication = null; SyncSelectedTopics(); }
    private void BeginContinuePublication(ReflectionView article) { OpenArticle(article); _confirmContinuePublication = article.Id; }
    private void CloseArticle() { _selected = null; _selectedTopicIds.Clear(); _confirmDeleteArticle = null; _confirmContinuePublication = null; }
    private void SyncSelectedTopics() { _selectedTopicIds.Clear(); _selectedTopicIds.AddRange(_selected?.WorkingVersion?.Topics.Select(topic => topic.Id) ?? []); }
    private void ToggleTopic(TopicId id, bool selected) { if (selected && !_selectedTopicIds.Contains(id)) _selectedTopicIds.Add(id); else if (!selected) _selectedTopicIds.Remove(id); }

    private async Task SaveArticleTopicsAsync() => await RunAsync(async services =>
    {
        if (_selected is null) return;
        if (_selectedTopicIds.Count == 0) throw new UseCaseException("topic.article.required", "请至少选择一个主题。");
        await services.GetRequiredService<AssignReflectionVersionTopicsUseCase>().ExecuteAsync(
            _selected.ContentDate, _selectedTopicIds[0], _selectedTopicIds.Skip(1).ToArray(), CancellationToken.None);
        await LoadAsync();
    }, "稿件主题已保存。");

    private async Task CreateTopicAsync() => await RunAsync(async services =>
    {
        await services.GetRequiredService<CreateTopicUseCase>().ExecuteAsync(_newTopicName, CancellationToken.None);
        _newTopicName = string.Empty;
        await LoadAsync();
    }, "主题已添加。");

    private void BeginTopicDelete(TopicSummary item)
    {
        if (item.ArticleCount > 0) { _error = "还有稿件使用这个主题，请先修改那些稿件的主题。"; return; }
        _confirmDeleteTopic = item.Topic.Id;
    }
    private void CancelTopicDelete() => _confirmDeleteTopic = null;
    private async Task DeleteTopicAsync(TopicId id) => await RunAsync(async services =>
    {
        await services.GetRequiredService<DeleteTopicUseCase>().ExecuteAsync(id, CancellationToken.None);
        _confirmDeleteTopic = null;
        await LoadAsync();
    }, "主题已删除。");

    private void CancelArticleDelete() => _confirmDeleteArticle = null;
    private void CancelContinuePublication() => _confirmContinuePublication = null;

    private async Task ContinuePublicationAsync() => await RunAsync(async services =>
    {
        if (_selected is null || !CanContinuePublish(_selected) ||
            !_publishedTargetsByReflection.TryGetValue(_selected.Id, out var targetId))
        {
            throw new UseCaseException("publication.historical_replacement_unavailable", "这篇稿件当前不能继续发布，请刷新后重试。");
        }

        var reflection = await services.GetRequiredService<GetReflectionUseCase>()
            .ExecuteAsync(_selected.ContentDate, CancellationToken.None);

        if (reflection?.WorkingVersion is null)
        {
            throw new UseCaseException("publication.reflection_unknown", "这一天没有可发布的稿件。");
        }

        if (reflection.Status != ReflectionStatus.Confirmed)
        {
            if (reflection.WorkingVersion.SourcesCheckedAtUtc is null)
            {
                throw new UseCaseException("reflection.confirm.source_check_pending", "来源检查尚未完成，请稍后刷新再发布。");
            }

            await services.GetRequiredService<ConfirmReflectionUseCase>().ExecuteAsync(
                reflection.ContentDate,
                new DailyMusings.Application.Reflections.ConfirmReflectionRequest(AcceptedUnsourcedClaims: true),
                CancellationToken.None);
        }

        var result = await services.GetRequiredService<RequestPublicationUseCase>().ExecuteAsync(
            reflection.ContentDate,
            targetId,
            PublicationVisibility.Public,
            actor: "admin",
            replaceExistingFile: false,
            manual: true,
            CancellationToken.None);

        if (!result.Queued)
        {
            throw new UseCaseException(
                result.Code ?? "publication.refused",
                AdminLabels.PublicationRefusalText(result.Code, result.Detail));
        }

        _confirmContinuePublication = null;
        await LoadAsync();
    }, "稿件已进入发布队列；完成后会替换这一天原来发布的稿件。");

    private async Task DeleteArticleAsync() => await RunAsync(async services =>
    {
        if (_selected is null) return;
        await services.GetRequiredService<DeleteReflectionUseCase>().ExecuteAsync(_selected.Id, CancellationToken.None);
        _selected = null; _confirmDeleteArticle = null; _selectedTopicIds.Clear();
        await LoadAsync();
    }, "稿件已删除，自动任务不会重新生成这一天；你手动生成仍然可以。");

    private async Task ReloadAsync() => await RunAsync(async _ => await LoadAsync(), "内容已刷新。");

    private async Task RunAsync(Func<IServiceProvider, Task> work, string success)
    {
        _busy = true; _message = null; _error = null;
        try
        {
            var failure = await AdminOperation.RunAsync(async () =>
            {
                await using var scope = ScopeFactory.CreateAsyncScope();
                await work(scope.ServiceProvider);
            }, Logger);
            if (failure is null) _message = success; else _error = failure;
        }
        finally { _busy = false; }
    }
}
