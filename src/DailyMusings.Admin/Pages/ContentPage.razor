        _editingDraft = false;
        _draftTitle = null;
        _draftSummary = null;
        _draftBody = null;
    }

    private async Task SaveDraftAsync() => await RunAsync(async services =>
    {
        if (_detailDate is not { } date)
        {
            return;
        }

        _detail = await services
            .GetRequiredService<EditReflectionVersionUseCase>()
            .ExecuteAsync(date, _draftTitle ?? string.Empty, _draftSummary ?? string.Empty, _draftBody ?? string.Empty, CancellationToken.None);

