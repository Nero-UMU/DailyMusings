        await LoadSourceInputsAsync(services);
        await LoadAsync();
        _message = "稿件已保存。旧正文的来源定位和检查结果已经清除，请重新检查后再确认。";
    });

    private async Task RunSourceCheckAsync() => await RunAsync(async services =>
    {
        if (_detailDate is not { } date || _detail?.WorkingVersionId is not { } versionId)
        {
            return;
        }

        var findings = await services
            .GetRequiredService<RunUnsourcedStatementCheckUseCase>()
            .ExecuteAsync(versionId, CancellationToken.None);

        _detail = await services.GetRequiredService<GetReflectionUseCase>().ExecuteAsync(date, CancellationToken.None);
        _acceptUnsourcedClaims = false;
        await LoadSourceInputsAsync(services);
        _message = findings == 0
            ? "检查完成，没有发现无法追溯到素材的陈述。"
            : $"检查完成，发现 {findings} 条需要人工判断的陈述。";
    });

    private async Task ConfirmDraftAsync() => await RunAsync(async services =>
    {
        if (_detailDate is not { } date)
        {
            return;
        }

        _detail = await services
            .GetRequiredService<ConfirmReflectionUseCase>()
            .ExecuteAsync(
                date,
                new DailyMusings.Application.Reflections.ConfirmReflectionRequest(_acceptUnsourcedClaims),
                CancellationToken.None);

        await LoadSourceInputsAsync(services);
        await LoadAsync();
        _message = $"已确认 {date} 的当前版本；现在可以在「发布设置」导出 Markdown。";
    });

    private async Task LoadSourceInputsAsync(IServiceProvider services)
    {
        _sourceInputs.Clear();

        if (_detail?.WorkingVersion is not { } version)
        {
            return;
        }

        var repository = services.GetRequiredService<IInputEntryRepository>();
        foreach (var id in version.Sources.Select(source => source.InputId).Distinct())
        {
            if (await repository.FindByIdAsync(id, CancellationToken.None) is { } entry)
            {
                _sourceInputs[id] = entry;
            }
        }
    }

    private string SourceInputText(InputEntryId id)
    {
        if (!_sourceInputs.TryGetValue(id, out var input))
        {
            return $"来源记录 {id} 已不可读。";
        }

        var text = input.TranscriptForGeneration;
        return string.IsNullOrWhiteSpace(text)
            ? $"{input.ContentDate} 的来源记录已按保留策略清理。"
            : $"{input.ContentDate}：{text}";
    }

    private static string ExcerptAt(
        string body,
        int blockIndex,
        int charStart,
        int charEnd,
        SourceDrift drift)
    {
        var paragraphs = ParagraphSplitter.Split(body);
        if (blockIndex < 0 || blockIndex >= paragraphs.Count)
        {
            return "（原文位置已经不存在）";
        }

        var paragraph = paragraphs[blockIndex];
        if (drift != SourceDrift.Exact || charStart < 0 || charEnd < charStart || charEnd > paragraph.Length)
        {
            return paragraph;
        }

        return paragraph[charStart..charEnd];
    }

    private static string SourceDriftText(SourceDrift drift) => drift switch
    {
        SourceDrift.Exact => "定位准确",
        SourceDrift.Drifted => "正文已改动",
        _ => "原位置已不存在",
    };

    private static string SemanticSearchText(SemanticSearchState state) => state switch
    {
        { Enabled: false } => "未启用，使用主题与全文匹配",
        { Available: true } => "可用",
        _ => "重建中，当前使用降级检索",
    };

    private async Task RegenerateAsync(ContentDate date) => await RunAsync(async services =>
    {
        var result = await services
            .GetRequiredService<RequestReflectionGenerationUseCase>()
            .ExecuteAsync(
                date,
                manual: true,
                _regenerateIgnoreFailures,
                _regenerateAcceptOverwrite,
                CancellationToken.None);

        if (!result.Decision.Allowed)
        {
            _error = $"{AdminLabels.GenerationRefusalText(result.Decision.Code, result.Decision.Detail)}"
                + $"（{result.Decision.Code}）";
            return;
        }

        await LoadAsync();
        _message = $"已把 {date} 的生成任务放进队列；生成完成后这一页会显示新的一版（旧版仍留在「上一版」槽）。";
    });

    private async Task SaveArticleTopicsAsync() => await RunAsync(async services =>
    {
        if (_detailDate is not { } date)
        {
            return;
        }

        var primary = ParseTopicToken(_primaryTopicToken);
        var secondaries = new List<TopicId>();

        foreach (var token in new[] { _secondaryTopicToken1, _secondaryTopicToken2 })
        {
            if (ParseTopicToken(token) is { } secondary && secondary != primary && !secondaries.Contains(secondary))
            {
                secondaries.Add(secondary);
            }
        }

        var updated = await services
            .GetRequiredService<AssignReflectionVersionTopicsUseCase>()
            .ExecuteAsync(date, primary, secondaries, CancellationToken.None);

        // Read the view back rather than reporting what was sent: the names on screen are what the instance stored.
        _detail = await services.GetRequiredService<GetReflectionUseCase>().ExecuteAsync(date, CancellationToken.None);

        await LoadAsync();

        _message = $"已把 {date} 的主题改为：{DescribeTopics(_detail?.WorkingVersion?.Topics.Select(topic => topic.Name) ?? Array.Empty<string>())}。"
            + $"（版本 {updated.Id}）";
    });

    private static TopicId? ParseTopicToken(string? token) =>
        Guid.TryParse(token, out var parsed) ? new TopicId(parsed) : null;

    private static string DescribeTopics(IEnumerable<string> names)
    {
        var list = names.ToArray();
        return list.Length == 0 ? "（没有主题）" : string.Join("、", list);
    }

    private async Task CreateTopicAsync() => await RunAsync(async services =>
    {
        if (string.IsNullOrWhiteSpace(_newTopicName))
        {
            _error = "主题名不能为空。";
            return;
        }

        var (topic, created) = await services
            .GetRequiredService<CreateTopicUseCase>()
            .ExecuteAsync(_newTopicName, CancellationToken.None);

        _newTopicName = null;
        await LoadTopicsAsync(services);

        _topicMessage = created
            ? $"已新增主题「{topic.Name}」。"
            : $"已经有一个等价的主题「{topic.Name}」，没有重复创建。";
    });

