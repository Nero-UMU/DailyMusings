@page "/"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IServiceScopeFactory ScopeFactory
@inject ILoggerFactory LoggerFactory

@* 状态分区：一个实例现在是什么样子。只有聚合数字，没有任何随想正文、标题或主题名 —— 这是刻意的，
   统计读数是最容易顺手把私人内容泄漏出去的地方（InstanceStatistics 的类型本身就不允许带这些字段）。 *@

<PageHeader Title="状态"
            Hint="今天的记录和实例状态。">
    <Actions>
        <button class="btn" @onclick="RefreshAsync" disabled="@_busy">刷新</button>
        <a class="btn btn-primary" href="/data">查看随想</a>
    </Actions>
</PageHeader>

@if (_error is not null)
{
    <p class="notice error">@_error</p>
}

@if (_statistics is null)
{
    <p class="muted">正在读取…</p>
}
else
{
    <div class="stat-grid">
        <div class="stat">
            <span class="label">今日随想（@_statistics.Today）</span>
            <span class="value">@_statistics.TodayInputCount</span>
            <span class="sub">录音 @_statistics.TodayVoiceCount · 手写 @_statistics.TodayTextCount</span>
        </div>
        <div class="stat">
            <span class="label">今日稿件状态</span>
            <span class="value value-sm">@AdminLabels.ReflectionText(_statistics.TodayReflectionStatus)</span>
            <span class="sub">
                @if (_statistics.LastGenerationAtUtc is { } last)
                {
                    <text>上次生成 @AdminFormat.When(last)（本地时间）</text>
                }
                else
                {
                    <text>还没有生成过</text>
                }
            </span>
        </div>
        <div class="stat">
            <span class="label">已公开导出</span>
            <span class="value">@_statistics.PublishedCount</span>
            <span class="sub">已写入发布目录</span>
        </div>
        <div class="stat">
            <span class="label">草稿 / 待发布</span>
            <span class="value">@_statistics.DraftReflectionCount / @_statistics.PendingPublicationCount</span>
            <span class="sub">未确认 / 等待发布</span>
        </div>
        <div class="stat">
            <span class="label">累计随想</span>
            <span class="value">@_statistics.TotalInputCount</span>
            <span class="sub">含已按保留策略清理内容的条目</span>
        </div>
        <div class="stat">
            <span class="label">累计稿件</span>
            <span class="value">@_statistics.TotalReflectionCount</span>
            <span class="sub">其中已确认 @_statistics.ConfirmedReflectionCount 篇</span>
        </div>
        <div class="stat">
            <span class="label">主题数</span>
            <span class="value">@_statistics.TopicCount</span>
            <span class="sub"><a href="/content">管理主题</a></span>
        </div>
        <div class="stat">
            <span class="label">设备</span>
            <span class="value">@_statistics.ActiveDeviceCount</span>
            <span class="sub">已撤销 @_statistics.RevokedDeviceCount 台</span>
        </div>
        <div class="stat">
            <span class="label">队列：待执行 / 执行中</span>
            <span class="value">@_statistics.QueuePending / @_statistics.QueueRunning</span>
            <span class="sub">
                失败 @_statistics.QueueFailed 条
                @if (_statistics.QueueFailed > 0)
                {
                    <text>· 失败任务在「系统设置」的日志里查</text>
                }
            </span>
        </div>
        <div class="stat">
            <span class="label">媒体占用</span>
            <span class="value value-sm">@AdminFormat.Bytes(_statistics.MediaBytes)</span>
            <span class="sub">录音等媒体文件</span>
        </div>
        <div class="stat">
            <span class="label">数据库占用</span>
            <span class="value value-sm">@AdminFormat.Bytes(_statistics.DatabaseBytes)</span>
            <span class="sub">SQLite 主文件</span>
        </div>
    </div>

    <div class="card-grid">
        <div class="card">
            <div class="card-head">
                <h2>服务状态</h2>
            </div>

            <div class="stack">
                <div>
                    <span class="badge @(_statistics.GenerationEnabled ? "badge-ok" : "badge-muted")">
                        文章生成模型@(_statistics.GenerationEnabled ? "已启用" : "未启用")
                    </span>
                    <span class="hint">
                        @if (_statistics.GenerationEnabled)
                        {
                            <text>按生成计划运行。</text>
                        }
                        else
                        {
                            <text>到<a href="/models">模型管理</a>启用。</text>
                        }
                    </span>
                </div>

                <div>
                    <span class="badge @(_statistics.SmtpConfigured ? "badge-ok" : "badge-muted")">
                        SMTP@(_statistics.SmtpConfigured ? "已启用" : "未启用")
                    </span>
                    <span class="hint">
                        @if (_statistics.SmtpConfigured)
                        {
                            <text>到<a href="/notifications">通知管理</a>设置收件地址和提醒事件。</text>
                        }
                        else
                        {
                            <text>到<a href="/notifications">通知管理</a>配置。</text>
                        }
                    </span>
                </div>

                <div>
                    <span class="badge @(_statistics.SemanticSearchAvailable ? "badge-ok" : "badge-warn")">
                        语义检索@(_statistics.SemanticSearchAvailable ? "可用" : "不可用")
                    </span>
                    <span class="hint">
                        @if (_statistics.SemanticSearchAvailable)
                        {
                            <text>历史内容可按语义查找。</text>
                        }
                        else
                        {
                            <text>
                                暂时按主题和文字查找历史内容。到<a href="/system">系统设置</a>查看语义索引。
                            </text>
                        }
                    </span>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-head">
                <h2>内容与时间</h2>
                <a class="btn btn-sm" href="/publishing">发布设置</a>
            </div>

            @if (_content is null)
            {
                <p class="muted">正在读取…</p>
            }
            else
            {
                <dl class="kv">
                    <dt>内容时区</dt>
                    <dd><code>@_content.TimeZoneId</code></dd>

                    <dt>生成时刻</dt>
                    <dd>@ContentSettings.FormatTime(_content.GenerationLocalTime)（内容时区）</dd>

                    <dt>导出（发布）时刻</dt>
                    <dd>@ContentSettings.FormatTime(_content.PublishLocalTime)（次日的这个时刻）</dd>

                    <dt>执行窗口</dt>
                    <dd>@_content.PublishWindowMinutes 分钟；超过时间后不会自动补发</dd>

                    <dt>录音保留</dt>
                    <dd>@RetentionText(_content.AudioRetentionDays)</dd>

                    <dt>内容保留</dt>
                    <dd>@RetentionText(_content.ContentRetentionDays)</dd>
                </dl>
            }
        </div>
    </div>
}

<div class="card">
    <div class="card-head">
        <h2>基础健康检查</h2>
        @if (_health is not null)
        {
            <span class="badge @(_health.Healthy ? "badge-ok" : "badge-err")">
                @(_health.Healthy ? "全部正常" : "存在失败项")
            </span>
        }
    </div>

    @if (_health is null)
    {
        <p class="muted">正在读取…</p>
    }
    else
    {
        <p class="hint">检查时间 @AdminFormat.When(_health.CheckedAtUtc)（本地时间）</p>

        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>检查项</th>
                        <th>结果</th>
                        <th>说明</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var probe in _health.Probes)
                    {
                        <tr>
                            <td>@AdminLabels.HealthProbeText(probe.Name)</td>
                            <td>
                                <span class="badge @(probe.Healthy ? "badge-ok" : "badge-err")">
                                    @(probe.Healthy ? "通过" : "失败")
                                </span>
                            </td>
                            <td class="muted">@(probe.Detail ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private InstanceStatistics? _statistics;
    private ContentSettings? _content;
    private HealthReport? _health;
    private string? _error;
    private bool _busy;

    private ILogger Logger => LoggerFactory.CreateLogger("DailyMusings.Admin.Dashboard");

    protected override async Task OnInitializedAsync()
    {
        // Guarded as well: an unguarded first load left the page on「正在读取…」for ever, or took the circuit down
        // when the database was momentarily unavailable.
        _error = await AdminOperation.RunAsync(LoadAsync, Logger);
    }

    private async Task RefreshAsync()
    {
        _busy = true;
        _error = null;

        try
        {
            var failure = await AdminOperation.RunAsync(LoadAsync, Logger);

            if (failure is not null)
            {
                _error = failure;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadAsync()
    {
        // A fresh scope per data load: the circuit outlives a request, so resolving scoped services into the
        // component would hold a database connection open for as long as the browser tab lives.
        await using var scope = ScopeFactory.CreateAsyncScope();
        var services = scope.ServiceProvider;

        _statistics = await services.GetRequiredService<IStatisticsReader>().ReadAsync(CancellationToken.None);
        _content = await services.GetRequiredService<IContentSettingsProvider>().GetAsync(CancellationToken.None);
        _health = await services.GetRequiredService<SystemHealthUseCase>().ExecuteAsync(CancellationToken.None);
    }

    private static string RetentionText(int days) => days switch
    {
        < 0 => "永久保留",
        0 => "当天草稿确认后立即删除",
        _ => $"确认后保留 {days} 天",
    };
}
