@page "/models"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IServiceScopeFactory ScopeFactory
@inject ILoggerFactory LoggerFactory

@* 模型管理分区：§8.1 的三块模型（转写 / 生成 / Embedding）。
   SMTP 不在这里 —— 它属于「通知管理」。 *@

<PageHeader Title="模型管理"
            Hint="分别配置 OpenAI 兼容的语音转写、文章生成与可选的 Embedding。保存后下一次调用即生效，不需要重启。">
    <Actions>
        <button class="btn" @onclick="ProbeAllAsync" disabled="@_busy">测试全部连接</button>
    </Actions>
</PageHeader>

<div class="notice info">
    <strong>这里只需要填写 API Key，不需要理解或填写内部存储名。</strong>
    <p>
        Key 只写不读：留空表示保持当前值，保存后输入框会立即清空。它会加密存放在实例数据目录之外，
        不进入配置表、日志、导出或备份。需要由运维系统托管凭据时，也可以改用部署时注入的
        Docker Secret 或环境变量。
    </p>
    <p>
        每个端点右上角的「密钥来源」会告诉你它当前用的是哪一个：后台填写 / Secret 文件 / 环境变量 / 未配置。
    </p>
    <p>
        新实例的文章生成默认填入 DeepSeek（<code>https://api.deepseek.com</code> / <code>deepseek-flash</code>）。
        DeepSeek 当前不提供语音转写或 Embedding 接口，因此这两项保留为可替换的 OpenAI 兼容端点，不会伪装成 DeepSeek 可用。
    </p>
</div>

@if (_message is not null)
{
    <p class="notice ok">@_message</p>
}

@if (_error is not null)
{
    <p class="notice error">@_error</p>
}

@if (_endpoints.Count == 0)
{
    <p class="muted">正在读取…</p>
}
else
{
    @foreach (var service in Services)
    {
        var endpoint = _endpoints.FirstOrDefault(item => item.Service == service);

        <div class="card">
            <div class="card-head">
                <h2>@Describe(service)</h2>
                <span>
                    @* The badge reads the staged value, not the last saved row: an operator who has just unticked
                       启用 must not be told the service is still enabled. *@
                    <span class="badge @(_enabled.GetValueOrDefault(service) ? "badge-ok" : "badge-muted")">
                        @(_enabled.GetValueOrDefault(service) ? "已启用" : "已停用")
                    </span>
                    <span class="badge @SecretSourceBadge(service)">
                        密钥来源：@SecretSourceText(service)
                    </span>
                </span>
            </div>

            @if (endpoint is null)
            {
                <p class="notice warn">未知的服务。</p>
            }
            else
            {
                <div class="form-grid">
                    <label class="checkbox">
                        <input type="checkbox" checked="@_enabled.GetValueOrDefault(service)"
                               @onchange="e => SetEnabled(service, e.Value is true)" />
                        启用
                    </label>
                    <label>
                        Base URL
                        <input value="@_baseUrls.GetValueOrDefault(service)" @oninput="e => SetBaseUrl(service, (string?)e.Value)" />
                    </label>
                    <label>
                        模型名
                        <input value="@_models.GetValueOrDefault(service)" @oninput="e => SetModel(service, (string?)e.Value)" />
                    </label>
                    <label>
                        API Key（留空表示不改）
                        <input type="password" autocomplete="new-password" placeholder="留空即保持现状"
                               value="@_passwords.GetValueOrDefault(service)"
                               @oninput="e => SetPassword(service, (string?)e.Value)" />
                    </label>
                    @if (_secretSources.GetValueOrDefault(service) == SecretSource.Ui)
                    {
                        <label class="checkbox">
                            <input type="checkbox" checked="@_clearPassword.GetValueOrDefault(service)"
                                   @onchange="e => SetClearPassword(service, e.Value is true)" />
                            清除在管理页保存的 API Key
                        </label>
                    }
                    <label>
                        超时（秒，5–600）
                        <input type="number" value="@_timeouts.GetValueOrDefault(service)" @onchange="e => SetTimeout(service, (string?)e.Value)" />
                    </label>
                    @if (service == "embedding")
                    {
                        <label>
                            维度（可选，1–4096）
                            <input type="number" value="@_dimensions" @onchange="e => SetDimensions((string?)e.Value)" />
                        </label>
                    }
                </div>

                <div class="actions">
                    <button class="btn-primary" @onclick="() => SaveEndpointAsync(service)" disabled="@_busy">保存</button>
                    <button class="btn" @onclick="() => ProbeAsync(service)" disabled="@_busy">测试连接</button>
                </div>

                @if (_probes.TryGetValue(service, out var probe))
                {
                    <p class="notice @(probe.Ok ? "ok" : "error")">
                        <strong>@(probe.Ok ? "可达。" : "测试失败。")</strong>
                        @probe.Detail（<code>@probe.Code</code>）
                    </p>
                }

                <p class="hint">
                    @if (service == "embedding")
                    {
                        <text>
                            关掉 Embedding 产品照常工作，历史检索退化为主题标签与全文匹配（§8.3）。
                            更换模型或维度会让旧索引整体失效，语义检索进入「重建中」，重建入口在「系统设置」。
                        </text>
                    }
                    else if (service == "transcription")
                    {
                        <text>转写关掉后，录音仍会被完整保存，只是不会有文字。</text>
                    }
                    else
                    {
                        <text>生成关掉时，调度器不会往队列里放生成任务，也就不会有新稿件。</text>
                    }
                </p>
            }
        </div>
    }
}

@code {
    /// <summary>The three endpoints §8.1 lists, in the order an operator meets them.</summary>
    private static readonly string[] Services = ["transcription", "generation", "embedding"];

    private readonly List<ModelEndpointView> _endpoints = [];

    /// <summary>One test-connection result per service, keyed by the service name this page uses.</summary>
    private readonly Dictionary<string, ProbeResult> _probes = new(StringComparer.Ordinal);

    /// <summary>Where each endpoint's secret resolves from, as the secret store reports it.</summary>
    private readonly Dictionary<string, SecretSource> _secretSources = new(StringComparer.Ordinal);

    private string? _message;
    private string? _error;
    private bool _busy;

    // Staged edits, keyed by service. A form that wrote on every keystroke would save half-typed URLs.
    private readonly Dictionary<string, bool> _enabled = [];
    private readonly Dictionary<string, string?> _baseUrls = [];
    private readonly Dictionary<string, string?> _models = [];
    private readonly Dictionary<string, string?> _secretNames = [];
    private readonly Dictionary<string, string?> _timeouts = [];
    private string? _dimensions;

    // 密码只进不出：输入框永远从空开始，提交后立刻清空，页面上不保留也不回显任何已存的值。
    private readonly Dictionary<string, string?> _passwords = [];
    private readonly Dictionary<string, bool> _clearPassword = [];

    private ILogger Logger => LoggerFactory.CreateLogger("DailyMusings.Admin.Models");

    protected override async Task OnInitializedAsync()
    {
        // Guarded as well: an unguarded first load terminated the circuit when the database was momentarily
        // unavailable, and the page stayed on「正在读取…」for ever with no explanation.
        _error = await AdminOperation.RunAsync(LoadAsync, Logger);
    }

    private async Task LoadAsync()
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        var services = scope.ServiceProvider;

        var endpoints = await services
            .GetRequiredService<ReadModelEndpointsUseCase>()
            .ExecuteAsync(CancellationToken.None);

        var secrets = services.GetRequiredService<ISecretStore>();

        _endpoints.Clear();
        _endpoints.AddRange(endpoints);

        foreach (var endpoint in endpoints)
        {
            _enabled[endpoint.Service] = endpoint.Enabled;
            _baseUrls[endpoint.Service] = endpoint.BaseUrl;
            _models[endpoint.Service] = endpoint.Model;
            _secretNames[endpoint.Service] = endpoint.SecretName;
            _timeouts[endpoint.Service] = endpoint.TimeoutSeconds.ToString(CultureInfo.InvariantCulture);

            // Reading the source is not reading the value: names are not secrets (§10.4), and "which of the three
            // places would this come from" is the question the form has to be able to answer.
            _secretSources[endpoint.Service] = string.IsNullOrWhiteSpace(endpoint.SecretName)
                ? SecretSource.None
                : secrets.ResolveSource(endpoint.SecretName);

        }

        _dimensions = endpoints
            .FirstOrDefault(endpoint => endpoint.Service == "embedding")?
            .Dimensions?
            .ToString(CultureInfo.InvariantCulture);
    }

    private static string Describe(string service) => service switch
    {
        "transcription" => "语音转写",
        "generation" => "文章生成",
        "embedding" => "Embedding（可选）",

        // Not a silent fallback to one of the above: this used to default to Embedding, so pressing "测试连接" on
        // the SMTP block reported "已测试 Embedding（可选）".
        _ => service,
    };

    private string SecretSourceText(string service) => _secretSources.GetValueOrDefault(service) switch
    {
        SecretSource.Ui => "后台填写",
        SecretSource.File => "Secret 文件",
        SecretSource.Environment => "环境变量",
        _ => "未配置",
    };

    private string SecretSourceBadge(string service) => _secretSources.GetValueOrDefault(service) switch
    {
        SecretSource.Ui or SecretSource.File or SecretSource.Environment => "badge-ok",
        _ => "badge-warn",
    };

    private void SetEnabled(string service, bool value) => _enabled[service] = value;

    private void SetBaseUrl(string service, string? value) => _baseUrls[service] = value;

    private void SetModel(string service, string? value) => _models[service] = value;

    private void SetPassword(string service, string? value) => _passwords[service] = value;

    private void SetClearPassword(string service, bool value) => _clearPassword[service] = value;

    private void SetTimeout(string service, string? value) => _timeouts[service] = value;

    private void SetDimensions(string? value) => _dimensions = value;

    private async Task SaveEndpointAsync(string service) => await RunAsync(async services =>
    {
        var timeout = int.TryParse(
            _timeouts.GetValueOrDefault(service),
            NumberStyles.Integer,
            CultureInfo.InvariantCulture,
            out var parsedTimeout)
                ? parsedTimeout
                : (int?)null;

        int? dimensions = null;
        if (service == "embedding" &&
            int.TryParse(_dimensions, NumberStyles.Integer, CultureInfo.InvariantCulture, out var parsedDimensions))
        {
            dimensions = parsedDimensions;
        }

        var password = string.IsNullOrEmpty(_passwords.GetValueOrDefault(service)) ? null : _passwords[service];
        var clearPassword = _clearPassword.GetValueOrDefault(service);

        await services
            .GetRequiredService<UpdateModelEndpointUseCase>()
            .ExecuteAsync(
                ParseModelService(service),
                new ModelEndpointUpdate(
                    _enabled.GetValueOrDefault(service),
                    _baseUrls.GetValueOrDefault(service),
                    _models.GetValueOrDefault(service),
                    // The storage name is an implementation detail. It is sent only when the write-only key is
                    // changing, so an ordinary settings save does not freeze a deployment-provided name in the DB.
                    password is not null || clearPassword ? _secretNames.GetValueOrDefault(service) : null,
                    timeout,
                    dimensions,
                    Password: password,
                    ClearPassword: clearPassword ? true : null),
                CancellationToken.None);

        await LoadAsync();
        _passwords[service] = string.Empty;
        _clearPassword[service] = false;
        _message = $"已保存{Describe(service)}的配置，下一次调用即生效。";
    });

    private async Task ProbeAsync(string service) => await RunAsync(async services =>
    {
        var result = await services
            .GetRequiredService<ProbeExternalServiceUseCase>()
            .ExecuteModelAsync(
                new ModelEndpointProbeRequest(
                    ParseService(service),
                    _baseUrls.GetValueOrDefault(service) ?? string.Empty,
                    _secretNames.GetValueOrDefault(service) ?? string.Empty,
                    _passwords.GetValueOrDefault(service)),
                CancellationToken.None);

        _probes[service] = result;
        _message = $"已测试{Describe(service)}。";
    });

    private async Task ProbeAllAsync() => await RunAsync(async services =>
    {
        var probe = services.GetRequiredService<ProbeExternalServiceUseCase>();

        foreach (var service in Services)
        {
            _probes[service] = await probe.ExecuteModelAsync(
                new ModelEndpointProbeRequest(
                    ParseService(service),
                    _baseUrls.GetValueOrDefault(service) ?? string.Empty,
                    _secretNames.GetValueOrDefault(service) ?? string.Empty,
                    _passwords.GetValueOrDefault(service)),
                CancellationToken.None);
        }

        _message = "三个端点都测过了，结果在各块里。";
    });

    /// <summary>The three endpoints §8.1 lists, for the settings write path.</summary>
    private static ModelService ParseModelService(string service) => service switch
    {
        "transcription" => ModelService.Transcription,
        "generation" => ModelService.Generation,
        _ => ModelService.Embedding,
    };

    /// <summary>Every service the probe knows, which also covers SMTP (used from the notifications page).</summary>
    private static ExternalService ParseService(string service) => service switch
    {
        "transcription" => ExternalService.Transcription,
        "generation" => ExternalService.Generation,
        _ => ExternalService.Embedding,
    };

    /// <summary>
    /// The single funnel every handler on this page goes through, so <c>_busy</c> and the message/error slots cannot
    /// drift apart per handler.
    /// <para>
    /// The body runs inside <c>AdminOperation</c>, which is the only thing standing between a handler and the
    /// circuit: an exception escaping an <c>@onclick</c> handler terminates the Blazor circuit, and from that moment
    /// every button on the page is dead — which the operator reports as 「保存 点不了」. <c>ErrorBoundary</c> never
    /// sees handler exceptions.
    /// </para>
    /// </summary>
    private async Task RunAsync(Func<IServiceProvider, Task> work)
    {
        _busy = true;
        _message = null;
        _error = null;

        try
        {
            var failure = await AdminOperation.RunAsync(
                async () =>
                {
                    await using var scope = ScopeFactory.CreateAsyncScope();
                    await work(scope.ServiceProvider);
                },
                Logger);

            if (failure is not null)
            {
                _error = failure;
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
