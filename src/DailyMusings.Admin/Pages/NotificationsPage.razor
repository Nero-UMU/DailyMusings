@page "/notifications"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IServiceScopeFactory ScopeFactory
@inject ILoggerFactory LoggerFactory

@* 通知管理分区：目前只支持邮件。SMTP 配置、收件邮箱、事件开关，以及「发送测试邮件」。
   这一页要能回答两个问题：「我配好了吗」和「它到底会不会发」。
   2026-09-24：邮件表单按 ani-rss 的形状重写——SMTP 地址、SMTP 端口、发件人邮箱（同时就是 SMTP 用户名）、
   密码、SSL、STARTTLS、收件人邮箱，七项都由用户自己填；不再有「安全方式」下拉，也没有常用邮箱预置。 *@

<PageHeader Title="通知管理"
            Hint="配置发件邮箱、收件地址和需要提醒的事件。通知只包含日期、标题与状态，不发送稿件正文。">
    <Actions>
        <button class="btn" @onclick="ProbeSmtpAsync" disabled="@_busy">测试连接</button>
        <button class="btn-primary" @onclick="SendTestEmailAsync" disabled="@_busy">发送测试邮件</button>
    </Actions>
</PageHeader>

<p class="notice warn">
    <strong>没填收件邮箱，或者三个事件开关全关，就什么都不会发。</strong>
    邮件功能由三件事共同决定：①「启用发信」打开；② 收件邮箱非空；③ 至少一个事件开关打开。
    任何一条不满足，实例都不会发出任何邮件——也不会报错，因为「不发」本来就是一个合法配置。
</p>

@if (_message is not null)
{
    <p class="notice ok">@_message</p>
}

@if (_error is not null)
{
    <p class="notice error">@_error</p>
}

@if (_test is not null)
{
    <p class="notice @(_test.Sent ? "ok" : "error")">
        <strong>@(_test.Sent ? "测试邮件已发出。" : "测试邮件没有发出去。")</strong>
        <br />
        @if (!string.IsNullOrWhiteSpace(_test.Detail))
        {
            @* The use case's own sentence, shown verbatim: it is written for the operator and already names the
               recipient or the classified reason. *@
            <span>@_test.Detail</span>
            <br />
        }
        <span class="hint">
            这封信发到：<code>@(_testedTo ?? "（没有收件邮箱）")</code>
            @if (_test.Sent)
            {
                <text>——去那个邮箱里找「[每日随想] 测试邮件」。</text>
            }
        </span>
    </p>
}

@if (_probe is not null)
{
    <p class="notice @(_probe.Ok ? "ok" : "error")">
        <strong>SMTP 连接测试：@(_probe.Ok ? "服务器有响应。" : "失败。")</strong>
        @_probe.Detail
        <br />
        <span class="hint">
            只读了服务器的问候语，不代表能发信——要确认能发，用「发送测试邮件」。
        </span>
    </p>
}

@if (_smtp is null)
{
    <p class="muted">正在读取…</p>
}
else
{
    <div class="card">
        <div class="card-head">
            <h2>邮件</h2>
            <span>
                <span class="badge @(_smtpEnabled ? "badge-ok" : "badge-muted")">
                    @(_smtpEnabled ? "已启用发信" : "未启用发信")
                </span>
                <span class="badge @PasswordSourceBadge()">密钥来源：@PasswordSourceText()</span>
            </span>
        </div>

        <p class="hint">
            请从邮箱服务商处获取 SMTP 地址、端口和密码。发件人邮箱同时作为登录用户名；保存后发送一封测试邮件确认配置。
        </p>

        <div class="form-grid">
            <label class="checkbox">
                <input type="checkbox" checked="@_smtpEnabled" @onchange="e => _smtpEnabled = e.Value is true" />
                启用发信
            </label>
            <label>
                SMTP 地址
                <input value="@_smtpHost" @onchange="e => _smtpHost = (string?)e.Value" placeholder="smtp.example.com" />
            </label>
            <label>
                SMTP 端口
                <input type="number" min="1" max="65535" value="@_smtpPort" @onchange="e => _smtpPort = (string?)e.Value"
                       placeholder="465 或 587" />
            </label>
            <label>
                发件人邮箱（同时是 SMTP 用户名）
                <input value="@_smtpFromAddress" @onchange="e => _smtpFromAddress = (string?)e.Value"
                       placeholder="noreply@example.com" />
            </label>
            <label>
                收件人邮箱（通知发给谁）
                <input value="@_toAddress" @onchange="e => _toAddress = (string?)e.Value" placeholder="owner@example.com" />
            </label>
        </div>

        <div class="form-grid">
            <label>
                密码（留空 = 不改）
                <input type="password" value="@_password" @onchange="e => _password = (string?)e.Value"
                       autocomplete="new-password" placeholder="留空表示不改，保存后清空" />
            </label>
        </div>

        @if (_smtp.PasswordSource == SecretSource.Ui)
        {
            <label class="checkbox">
                <input type="checkbox" checked="@_clearPassword" @onchange="e => _clearPassword = e.Value is true" />
                清除在管理页保存的密码（清除后自动回退到部署配置）
            </label>
        }

        <div class="stack">
            <label class="checkbox">
                <input type="checkbox" checked="@_useSsl" @onchange="e => _useSsl = e.Value is true" />
                SSL
            </label>
            <p class="hint">
                勾上 = 连上立刻 TLS 握手，问候语也在隧道里，端口通常是 <strong>465</strong>。
                别的软件里写作「SSL：是，STARTTLS：否」。
            </p>

            <label class="checkbox">
                <input type="checkbox" checked="@_useStartTls" @onchange="e => _useStartTls = e.Value is true" />
                STARTTLS
            </label>
            <p class="hint">
                勾上 = 先明文打招呼再升级加密，端口通常是 <strong>587</strong>。
                别的软件里写作「SSL：否，STARTTLS：是」。
            </p>
        </div>

        <p class="hint">
            <strong>SSL 与 STARTTLS 只能选一个。</strong>常见配置为 465 + SSL，或 587 + STARTTLS；请以邮箱服务商提供的信息为准。
            使用密码时必须选择一种加密方式。
        </p>

        <p class="hint">
            <strong>密码输入框只提交、不回显</strong>：保存后页面只会显示「密钥来源」，值本身永远不会回到浏览器，
            也不会进入日志、导出或备份。留空表示继续使用已保存的密码。
        </p>

        <div class="actions">
            <button class="btn-primary" @onclick="SaveSmtpAsync" disabled="@_busy">保存</button>
            <button class="btn" @onclick="SendTestEmailAsync" disabled="@_busy">发送测试邮件</button>
        </div>
    </div>

    <div class="card">
        <div class="card-head">
            <h2>事件</h2>
            <span class="badge @(_notificationDraftReady || _notificationJobFailed || _notificationAutomatic ? "badge-ok" : "badge-warn")">
                @(_notificationDraftReady || _notificationJobFailed || _notificationAutomatic ? "至少一个事件已开启" : "三个开关都关着，不会发信")
            </span>
        </div>

        @if (_notifications is null)
        {
            <p class="muted">正在读取…</p>
        }
        else
        {
            <div class="stack">
                <label class="checkbox">
                    <input type="checkbox" checked="@_notificationDraftReady" @onchange="e => _notificationDraftReady = e.Value is true" />
                    新草稿待确认时发信
                </label>
                <label class="checkbox">
                    <input type="checkbox" checked="@_notificationJobFailed" @onchange="e => _notificationJobFailed = e.Value is true" />
                    任务最终失败时发信
                </label>
                <label class="checkbox">
                    <input type="checkbox" checked="@_notificationAutomatic" @onchange="e => _notificationAutomatic = e.Value is true" />
                    自动发布有结果时发信
                </label>
            </div>

            <div class="form-grid">
                <label>
                    实例地址（邮件里的链接）
                    <input value="@_notificationsInstanceUrl" @onchange="e => _notificationsInstanceUrl = (string?)e.Value"
                           placeholder="http://192.168.1.10:18321" />
                </label>
            </div>

            <div class="actions">
                <button class="btn-primary" @onclick="SaveNotificationsAsync" disabled="@_busy">保存事件开关</button>
            </div>

            <p class="notice @(_notifications.SmtpConfigured ? "ok" : "warn")">
                SMTP：@(_notifications.SmtpConfigured ? "已启用" : "未启用，当前不会发出任何邮件")
                · 收件邮箱：<code>@(string.IsNullOrWhiteSpace(_notifications.ToAddress) ? "（未填，什么都发不出去）" : _notifications.ToAddress)</code>
            </p>

            <p class="hint">
                收件地址在上方「邮件」卡片修改；这里选择哪些事件需要通知，并填写邮件中用于返回管理后台的地址。
            </p>
        }
    </div>
}

@code {
    private SmtpSettingsView? _smtp;
    private NotificationSettingsView? _notifications;

    private bool _smtpEnabled;
    private string? _smtpHost;
    private string? _smtpPort;
    private string? _smtpFromAddress;
    private bool _useSsl;
    private bool _useStartTls;
    private string? _toAddress;

    /// <summary>Staged password. Never read back from the server — the form only ever writes it.</summary>
    private string? _password;
    private bool _clearPassword;

    private string? _notificationsInstanceUrl;
    private bool _notificationDraftReady;
    private bool _notificationJobFailed;
    private bool _notificationAutomatic;

    private SmtpTestResult? _test;
    private string? _testedTo;
    private ProbeResult? _probe;

    private string? _message;
    private string? _error;
    private bool _busy;

    private ILogger Logger => LoggerFactory.CreateLogger("DailyMusings.Admin.Notifications");

    protected override async Task OnInitializedAsync()
    {
        _error = await AdminOperation.RunAsync(LoadAsync, Logger);
    }

    private async Task LoadAsync()
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        var services = scope.ServiceProvider;

        _smtp = await services.GetRequiredService<ReadSmtpSettingsUseCase>().ExecuteAsync(CancellationToken.None);
        _smtpEnabled = _smtp.Enabled;
        _smtpHost = _smtp.Host;
        _smtpPort = _smtp.Port.ToString(CultureInfo.InvariantCulture);
        _smtpFromAddress = _smtp.FromAddress;
        _useSsl = _smtp.UseSsl;
        _useStartTls = _smtp.UseStartTls;
        _toAddress = _smtp.ToAddress;

        // The staged password is dropped on every read: what is on screen must never be a value the server sent.
        _password = null;
        _clearPassword = false;

        _notifications = await services
            .GetRequiredService<ReadNotificationSettingsUseCase>()
            .ExecuteAsync(CancellationToken.None);

        _notificationsInstanceUrl = _notifications.InstanceUrl;
        _notificationDraftReady = _notifications.DraftReady;
        _notificationJobFailed = _notifications.JobFailed;
        _notificationAutomatic = _notifications.AutomaticPublication;
    }

    private string PasswordSourceText() => _smtp?.PasswordSource switch
    {
        SecretSource.Ui => "后台填写",
        SecretSource.File => "Secret 文件",
        SecretSource.Environment => "环境变量",
        _ => "未配置（本机中继可以没有密码）",
    };

    private string PasswordSourceBadge() => _smtp?.PasswordSource switch
    {
        SecretSource.Ui or SecretSource.File or SecretSource.Environment => "badge-ok",
        _ => "badge-muted",
    };

    private async Task SaveSmtpAsync() => await RunAsync(async services =>
    {
        await services
            .GetRequiredService<UpdateSmtpSettingsUseCase>()
            .ExecuteAsync(
                new SmtpSettingsUpdate(
                    _smtpEnabled,
                    _smtpHost,
                    int.TryParse(_smtpPort, NumberStyles.Integer, CultureInfo.InvariantCulture, out var port) ? port : null,
                    _smtpFromAddress,
                    _useSsl,
                    _useStartTls,

                    // Write-only, and only when something was typed: an empty box means "leave the stored one alone".
                    Password: string.IsNullOrEmpty(_password) ? null : _password,
                    ClearPassword: _clearPassword ? true : null,
                    ToAddress: _toAddress),
                CancellationToken.None);

        // Reads back, which also empties the password box: what was typed is now stored, and the form must not look
        // as if it still held it.
        await LoadAsync();

        _message = "已保存邮件配置。保存后下一次发信即按新值执行，不需要重启。";
    });

    private async Task SaveNotificationsAsync() => await RunAsync(async services =>
    {
        await services
            .GetRequiredService<UpdateNotificationSettingsUseCase>()
            .ExecuteAsync(
                // The recipient is owned by the mail card's own save, which validates it as an address; passing it
                // here as well would be a second, unvalidated way to write the same key.
                toAddress: null,
                _notificationsInstanceUrl ?? string.Empty,
                _notificationDraftReady,
                _notificationJobFailed,
                _notificationAutomatic,
                CancellationToken.None);

        // Read back rather than trusting the form: what the instance stored is what the next mail will use.
        _notifications = await services
            .GetRequiredService<ReadNotificationSettingsUseCase>()
            .ExecuteAsync(CancellationToken.None);

        _message = "已保存通知事件开关。";
    });

    /// <summary>
    /// Sends one real message. Deliberately not the same thing as 「测试连接」, which only reads the greeting: a
    /// relay that will reject every message still greets you politely.
    /// </summary>
    private async Task SendTestEmailAsync() => await RunAsync(async services =>
    {
        var recipient = string.IsNullOrWhiteSpace(_toAddress) ? _smtp?.ToAddress : _toAddress;

        _test = await services
            .GetRequiredService<SendTestEmailUseCase>()
            .ExecuteAsync(_toAddress, CancellationToken.None);

        _testedTo = recipient;
    });

    private async Task ProbeSmtpAsync() => await RunAsync(async services =>
    {
        _probe = await services
            .GetRequiredService<ProbeExternalServiceUseCase>()
            .ExecuteAsync(ExternalService.Smtp, CancellationToken.None);
    });

    /// <summary>
    /// The single funnel every handler on this page goes through. The body runs inside <c>AdminOperation</c>:
    /// an exception escaping an <c>@onclick</c> handler terminates the Blazor circuit, after which every control on
    /// the page is inert — which the operator reports as 「保存 点不了」.
    /// </summary>
    private async Task RunAsync(Func<IServiceProvider, Task> work)
    {
        _busy = true;
        _message = null;
        _error = null;
        _test = null;
        _testedTo = null;
        _probe = null;

        try
        {
            var failure = await AdminOperation.RunAsync(
                async () =>
                {
                    await using var scope = ScopeFactory.CreateAsyncScope();
                    await work(scope.ServiceProvider);
                },
                Logger);

            if (failure is not null)
            {
                _error = failure;
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
