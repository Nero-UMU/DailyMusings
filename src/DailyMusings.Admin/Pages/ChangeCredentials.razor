@page "/change-credentials"
@attribute [Authorize]

<h1>修改账号与密码</h1>

<p class="hint">
    首次登录必须同时更换账号名和密码：初始账号 <code>admin</code> 与启动时打印的初始密码都是公开已知的。
    修改后本次登录会失效，需要重新登录。
</p>

@if (Message is not null)
{
    <p class="notice error">@Message</p>
}

<div class="card">
    <form method="post" action="@ApiRoutes.AdminChangeCredentials" data-enhance="false" class="form">
        <label>
            当前密码
            <input name="currentPassword" type="password" autocomplete="current-password" required />
        </label>
        <label>
            新账号
            <input name="newUsername" autocomplete="username" required minlength="3" maxlength="64" />
        </label>
        <label>
            新密码（至少 12 位）
            <input name="newPassword" type="password" autocomplete="new-password" required minlength="12" />
        </label>
        <label>
            确认新密码
            <input name="confirmPassword" type="password" autocomplete="new-password" required minlength="12" />
        </label>
        <div class="actions">
            <button type="submit" class="btn-primary">保存</button>
        </div>
    </form>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private string? Message => Error switch
    {
        "invalid" => "当前密码不正确。",
        "mismatch" => "两次输入的新密码不一致。",
        "weak" => "新密码不满足要求（至少 12 位），或新账号格式不合法。",
        "unchanged" => "新凭据与当前凭据相同。",
        "required" => "请填写全部字段。",
        _ => null,
    };
}
