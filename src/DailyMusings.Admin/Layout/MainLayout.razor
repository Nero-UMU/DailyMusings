@inherits LayoutComponentBase

@* 八个功能分区的外壳。分区顺序就是用户要求的菜单顺序，图标与文字一起出现，选中项由 NavLink 自己标记。 *@
<div class="app">
    <svg class="icon-sprite" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <symbol id="dm-status" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M7 16v-4m5 4V8m5 8v-6"/></symbol>
        <symbol id="dm-devices" viewBox="0 0 24 24"><rect x="6" y="2.5" width="12" height="19" rx="2.5"/><path d="M10 18.5h4"/></symbol>
        <symbol id="dm-data" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2.5"/><path d="M3 10h18M8 5V3h8v2"/></symbol>
        <symbol id="dm-models" viewBox="0 0 24 24"><rect x="5" y="5" width="14" height="14" rx="3"/><path d="M9 2v3m6-3v3M9 19v3m6-3v3M2 9h3m-3 6h3m14-6h3m-3 6h3M9 12h6"/></symbol>
        <symbol id="dm-notifications" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m4 7 8 6 8-6"/></symbol>
        <symbol id="dm-publishing" viewBox="0 0 24 24"><path d="M12 16V3m-4 4 4-4 4 4M4 14v5a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5"/></symbol>
        <symbol id="dm-content" viewBox="0 0 24 24"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 8h6M9 12h6M9 16h4"/></symbol>
        <symbol id="dm-system" viewBox="0 0 24 24"><path d="M4 7h16M4 17h16"/><circle cx="9" cy="7" r="2"/><circle cx="15" cy="17" r="2"/></symbol>
        <symbol id="dm-logout" viewBox="0 0 24 24"><path d="M10 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h4m4-4 4-4-4-4m4 4H9"/></symbol>
    </svg>
    @if (IsAuthenticated)
    {
        <aside class="sidebar">
            <a class="brand" href="/">
                <img class="brand-mark" src="_content/DailyMusings.Admin/logo.png?v=20261001-logo" alt="" />
                <span class="brand-text">
                    每日随想
                    <small>管理</small>
                </span>
            </a>

            @* NavLink rather than <a>: it marks the current route, so the operator can see where they are. *@
            <nav class="nav">
                <NavLink href="/" Match="NavLinkMatch.All">
                    <svg class="nav-icon" aria-hidden="true"><use href="#dm-status" /></svg>状态
                </NavLink>
                <NavLink href="/devices">
                    <svg class="nav-icon" aria-hidden="true"><use href="#dm-devices" /></svg>设备
                </NavLink>
                <NavLink href="/data">
                    <svg class="nav-icon" aria-hidden="true"><use href="#dm-data" /></svg>数据管理
                </NavLink>
                <NavLink href="/models">
                    <svg class="nav-icon" aria-hidden="true"><use href="#dm-models" /></svg>模型管理
                </NavLink>
                <NavLink href="/notifications">
                    <svg class="nav-icon" aria-hidden="true"><use href="#dm-notifications" /></svg>通知管理
                </NavLink>
                <NavLink href="/publishing">
                    <svg class="nav-icon" aria-hidden="true"><use href="#dm-publishing" /></svg>发布设置
                </NavLink>
                <NavLink href="/content">
                    <svg class="nav-icon" aria-hidden="true"><use href="#dm-content" /></svg>内容管理
                </NavLink>
                <NavLink href="/system">
                    <svg class="nav-icon" aria-hidden="true"><use href="#dm-system" /></svg>系统设置
                </NavLink>
            </nav>

            @* A plain form post, not an interactive round trip: only an HTTP response can clear the cookie. *@
            <form method="post" action="@ApiRoutes.AdminSignOut" data-enhance="false" class="sidebar-footer">
                <button type="submit" class="btn btn-ghost btn-block" aria-label="退出登录">
                    <svg class="logout-icon" aria-hidden="true"><use href="#dm-logout" /></svg>
                    <span class="logout-label">退出登录</span>
                </button>
            </form>
        </aside>
    }

    <div class="content">
        <main class="main">
            @Body
        </main>

    </div>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private bool IsAuthenticated { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (AuthenticationState is not null)
        {
            var state = await AuthenticationState;
            IsAuthenticated = state.User.Identity?.IsAuthenticated == true;
        }
    }
}
