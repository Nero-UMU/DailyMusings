@inherits LayoutComponentBase
@inject IHttpContextAccessor HttpContextAccessor

<div class="app">
    @if (IsAuthenticated)
    {
        <aside class="sidebar">
            <a class="brand" href="/">
                <span class="brand-mark">每</span>
                <span class="brand-text">
                    每日随想
                    <small>管理</small>
                </span>
            </a>

            @* NavLink rather than <a>: it marks the current route, so the operator can see where they are. *@
            <nav class="nav">
                <NavLink href="/" Match="NavLinkMatch.All">状态</NavLink>
                <NavLink href="/devices">设备</NavLink>
                <NavLink href="/inputs">采集</NavLink>
                <NavLink href="/models">模型与邮件</NavLink>
                <NavLink href="/publishing">发布</NavLink>
                <NavLink href="/settings">实例设置</NavLink>
                <NavLink href="/operations">运维</NavLink>
                <NavLink href="/change-credentials">账号</NavLink>
            </nav>

            @* A plain form post, not an interactive round trip: only an HTTP response can clear the cookie. *@
            <form method="post" action="@ApiRoutes.AdminSignOut" data-enhance="false" class="sidebar-footer">
                <button type="submit" class="btn btn-ghost btn-block">退出登录</button>
            </form>
        </aside>
    }

    <div class="content">
        <main class="main">
            @if (IsInsecure)
            {
                @* §10.3: this must persist for as long as the insecure connection is in use, and must never imply
                   that acknowledging the risk made the connection safe. *@
                <p class="notice error">
                    <strong>当前连接未加密（HTTP）。</strong>
                    密码、设备令牌、录音与文章都可能被同一网络中的其他人截获。
                    建议改用 HTTPS、局域网或 VPN 访问。本提示只说明风险，不提供任何保护。
                </p>
            }

            @Body
        </main>

        <footer class="footer">
            单用户自托管实例 · 管理页不承担日常创作
        </footer>
    </div>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private bool IsAuthenticated { get; set; }

    /// <summary>
    /// Whether the page was reached over plain HTTP.
    /// <para>
    /// Only ever assigned from a real request. The layout is rendered inside interactive circuits as well, and there
    /// <c>HttpContext</c> is null — reading that as "secure" used to drop the warning from every page that upgrades
    /// to an interactive render mode, which is exactly the set of pages an operator sits on longest.
    /// </para>
    /// </summary>
    private bool IsInsecure { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (HttpContextAccessor.HttpContext?.Request.IsHttps is { } isHttps)
        {
            IsInsecure = !isHttps;
        }

        if (AuthenticationState is not null)
        {
            var state = await AuthenticationState;
            IsAuthenticated = state.User.Identity?.IsAuthenticated == true;
        }
    }
}
