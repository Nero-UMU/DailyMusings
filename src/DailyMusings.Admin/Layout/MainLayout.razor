@inherits LayoutComponentBase

@* 八个功能分区的外壳。分区顺序就是用户要求的菜单顺序，图标与文字一起出现，选中项由 NavLink 自己标记。 *@
<div class="app">
    @if (IsAuthenticated)
    {
        <aside class="sidebar">
            <a class="brand" href="/">
                <img class="brand-mark" src="_content/DailyMusings.Admin/logo.png" alt="" />
                <span class="brand-text">
                    每日随想
                    <small>管理</small>
                </span>
            </a>

            @* NavLink rather than <a>: it marks the current route, so the operator can see where they are. *@
            <nav class="nav">
                <NavLink href="/" Match="NavLinkMatch.All">
                    <span class="nav-icon" aria-hidden="true">📊</span>状态
                </NavLink>
                <NavLink href="/devices">
                    <span class="nav-icon" aria-hidden="true">📱</span>设备
                </NavLink>
                <NavLink href="/data">
                    <span class="nav-icon" aria-hidden="true">🗂️</span>数据管理
                </NavLink>
                <NavLink href="/models">
                    <span class="nav-icon" aria-hidden="true">🧠</span>模型管理
                </NavLink>
                <NavLink href="/notifications">
                    <span class="nav-icon" aria-hidden="true">✉️</span>通知管理
                </NavLink>
                <NavLink href="/publishing">
                    <span class="nav-icon" aria-hidden="true">🚀</span>发布设置
                </NavLink>
                <NavLink href="/content">
                    <span class="nav-icon" aria-hidden="true">📝</span>内容管理
                </NavLink>
                <NavLink href="/system">
                    <span class="nav-icon" aria-hidden="true">⚙️</span>系统设置
                </NavLink>
            </nav>

            @* A plain form post, not an interactive round trip: only an HTTP response can clear the cookie. *@
            <form method="post" action="@ApiRoutes.AdminSignOut" data-enhance="false" class="sidebar-footer">
                <button type="submit" class="btn btn-ghost btn-block">退出登录</button>
            </form>
        </aside>
    }

    <div class="content">
        <main class="main">
            @Body
        </main>

        <footer class="footer">
            单用户自托管实例 · 管理页负责配置与运维，不承担日常创作
        </footer>
    </div>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private bool IsAuthenticated { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (AuthenticationState is not null)
        {
            var state = await AuthenticationState;
            IsAuthenticated = state.User.Identity?.IsAuthenticated == true;
        }
    }
}
