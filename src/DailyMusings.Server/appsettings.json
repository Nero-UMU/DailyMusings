{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "RootPath": ".",
    "SecretsPath": "/run/secrets",
    "KeyRingPath": "keys"
  },
  "Transcription": {
    "_comment": "Disabled until an operator configures an endpoint. SecretName refers to a file under Storage:SecretsPath — the value itself never appears in configuration (§10.4).",
    "Enabled": false,
    "BaseUrl": "https://api.openai.com/v1",
    "Model": "whisper-1",
    "SecretName": "openai-api-key",
    "TimeoutSeconds": 120,
    "LanguageHint": null
  }
}
