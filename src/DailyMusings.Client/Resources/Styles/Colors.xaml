<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        The phone's palette: a near-black background with lifted cards, one cyan-blue accent and one green accent,
        and a red reserved for destructive actions. The app is used in the dark, one-handed, for a few seconds at a
        time, so the contrast that matters is 「文字比背景亮多少」 rather than decorative colour.
    -->

    <Color x:Key="Bg">#101418</Color>
    <Color x:Key="BgElevated">#161B20</Color>
    <Color x:Key="Surface">#1B2025</Color>
    <Color x:Key="SurfacePressed">#242B32</Color>
    <Color x:Key="Divider">#2A3138</Color>

    <Color x:Key="Accent">#4C9AFF</Color>
    <Color x:Key="AccentPressed">#3B82D6</Color>
    <Color x:Key="AccentSoft">#1D3350</Color>
    <Color x:Key="AccentGreen">#3DDC97</Color>
    <Color x:Key="Danger">#FF6B6B</Color>
    <Color x:Key="DangerSoft">#3A1F22</Color>
    <Color x:Key="Warn">#F0B429</Color>

    <Color x:Key="TextPrimary">#E6EDF3</Color>
    <Color x:Key="TextSecondary">#9AA5B1</Color>
    <Color x:Key="TextMuted">#6E7A87</Color>
    <Color x:Key="TextOnAccent">#07121F</Color>
    <Color x:Key="Transparent">Transparent</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource Bg}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource Divider}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
</ResourceDictionary>
