<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DailyMusings.Client.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:DailyMusings.Client.Pages"
    Title="每日随想">

    <!-- §9.3: 今日 / 草稿 / 设置 are the screens the loop needs — capture, review and publish, then config.
         日历 and 主题 follow on top of the same read APIs. -->
    <TabBar>
        <ShellContent
            Title="今日"
            ContentTemplate="{DataTemplate pages:TodayPage}"
            Route="today" />
        <ShellContent
            Title="草稿"
            ContentTemplate="{DataTemplate pages:DraftPage}"
            Route="draft" />
        <ShellContent
            Title="设置"
            ContentTemplate="{DataTemplate pages:SettingsPage}"
            Route="settings" />
    </TabBar>

</Shell>
