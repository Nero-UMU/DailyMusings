<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DailyMusings.Client.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:DailyMusings.Client.Pages"
    Title="每日随想">

    <!--
        The phone does three things (2026-09-24 scope): capture a thought and read what was recognised back,
        look through the recordings and notes kept on this device, and configure the connection. Drafts, topics,
        source review and publishing are the admin pages' business now.
    -->
    <TabBar>
        <ShellContent
            Title="今日随想"
            Route="today"
            ContentTemplate="{DataTemplate pages:CapturePage}">
            <ShellContent.Icon>
                <FileImageSource File="tab_today.png" />
            </ShellContent.Icon>
        </ShellContent>

        <ShellContent
            Title="日历"
            Route="calendar"
            ContentTemplate="{DataTemplate pages:CalendarPage}">
            <ShellContent.Icon>
                <FileImageSource File="tab_calendar.png" />
            </ShellContent.Icon>
        </ShellContent>

        <ShellContent
            Title="设置"
            Route="settings"
            ContentTemplate="{DataTemplate pages:SettingsPage}">
            <ShellContent.Icon>
                <FileImageSource File="tab_settings.png" />
            </ShellContent.Icon>
        </ShellContent>
    </TabBar>

</Shell>
