<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DailyMusings.Client.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:DailyMusings.Client.Pages"
    Title="每日随想">

    <!-- §9.3: 今日 and 设置 are the two screens the capture loop needs. 日历 / 主题 / 草稿 arrive with the phases
         that produce content to show on them. -->
    <TabBar>
        <ShellContent
            Title="今日"
            ContentTemplate="{DataTemplate pages:TodayPage}"
            Route="today" />
        <ShellContent
            Title="设置"
            ContentTemplate="{DataTemplate pages:SettingsPage}"
            Route="settings" />
    </TabBar>

</Shell>
