<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DailyMusings.Client.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:DailyMusings.Client.Pages"
    Title="每日随想">

    <!-- §9.3: 今日 / 日历 / 主题 / 草稿 / 设置 — capture, look back, keep the vocabulary usable, review, config. -->
    <TabBar>
        <ShellContent
            Title="今日"
            ContentTemplate="{DataTemplate pages:TodayPage}"
            Route="today" />
        <ShellContent
            Title="草稿"
            ContentTemplate="{DataTemplate pages:DraftPage}"
            Route="draft" />
        <ShellContent
            Title="日历"
            ContentTemplate="{DataTemplate pages:CalendarPage}"
            Route="calendar" />
        <ShellContent
            Title="主题"
            ContentTemplate="{DataTemplate pages:TopicsPage}"
            Route="topics" />
        <ShellContent
            Title="设置"
            ContentTemplate="{DataTemplate pages:SettingsPage}"
            Route="settings" />
    </TabBar>

</Shell>
