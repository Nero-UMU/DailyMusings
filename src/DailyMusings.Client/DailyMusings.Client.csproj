<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- §18: Android in phase two, Windows in phase five. Everything shared lives in DailyMusings.Client.Core, so
		     the second target added one line here plus a platform recorder — and nothing else in the project assumed
		     Android. -->
		<TargetFrameworks>net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks>

		<!-- Directory.Build.props applies a net10.0 default to every project. It is evaluated before this project
		     body, so it cannot see TargetFrameworks and must be cleared here or the build would try a bare net10.0
		     inner target. -->
		<TargetFramework></TargetFramework>

		<OutputType>Exe</OutputType>
		<RootNamespace>DailyMusings.Client</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>

		<!-- The MAUI template's package versions ride $(MauiVersion), which is not defined when the central package
		     file is evaluated, so this project manages its own versions. -->
		<ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>

		<!-- XAML and platform analyzers are noisier than the server-side projects and cannot be fixed here. -->
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>

		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>每日随想</ApplicationTitle>
		<ApplicationId>dev.dailymusings.client</ApplicationId>

		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Android 8.0 / API 26, per decision A.11: the runtime permission model is settled by then and it avoids
		     the legacy storage-permission branches that older targets drag in. -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>

		<!-- Windows 10 1809 is the floor for the Windows App SDK's WinUI 3, and it is old enough that no build
		     machine or user machine in this product's life will be below it. -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

		<!-- The Windows client is packaged as an MSIX so it can be installed like an application rather than run
		     out of a folder; the server-side build does not touch this because it targets the Windows TFM only. -->
		<RuntimeIdentifier Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">win-x64</RuntimeIdentifier>
		<UseWinUI Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">true</UseWinUI>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\DailyMusings.Client.Core\DailyMusings.Client.Core.csproj" />
	</ItemGroup>

</Project>
