<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android is the only target. The desktop client was dropped from the project's direction: everything
		     shared lives in DailyMusings.Client.Core, and the platform layer is now a single implementation. -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>

		<!-- Directory.Build.props applies a net10.0 default to every project. It is evaluated before this project
		     body, so it cannot see TargetFrameworks and must be cleared here or the build would try a bare net10.0
		     inner target. -->
		<TargetFramework></TargetFramework>

		<OutputType>Exe</OutputType>
		<RootNamespace>DailyMusings.Client</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>

		<!-- The MAUI template's package versions ride $(MauiVersion), which is not defined when the central package
		     file is evaluated, so this project manages its own versions. -->
		<ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>

		<!-- XAML and platform analyzers are noisier than the server-side projects and cannot be fixed here. -->
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>

		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>每日随想</ApplicationTitle>
		<ApplicationId>dev.dailymusings.client</ApplicationId>

		<!-- 这两个是**本地开发用**的默认值，取「最近一次发布」的版本号。发布时由 release.yml 从 tag 推导
		     并覆盖：v1.2.3 → ApplicationDisplayVersion=1.2.3、ApplicationVersion=10203（major*10000+minor*100+patch）。

		     这里必须跟着发布更新，不能留在某个固定值上：versionCode 要随每次发布**单调递增**，否则手机会
		     拒绝覆盖安装（表现为「应用未安装」）。1.0.3 那一轮修的就是它——此前一直写死 1，所有发布的 APK
		     都装不上已装的旧版。反过来说，本地构建的 versionCode 若低于手机上已装的发布版，同样装不上去，
		     所以默认值取最近一次发布的值而不是 1。 -->
		<ApplicationDisplayVersion>1.2.3</ApplicationDisplayVersion>
		<ApplicationVersion>10203</ApplicationVersion>

		<!-- Android 8.0 / API 26, per decision A.11: the runtime permission model is settled by then and it avoids
		     the legacy storage-permission branches that older targets drag in. -->
		<SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon：单张位图。logo 自带深色底（藏青 #0C1C34），所以这里取同一个藏青而不是白——
		     取白的话，自适应图标被系统裁形时四角会露出一圈白边。图本身已经处理成满幅（导出时留下的
		     黑边已填成藏青），且内容缩到 80%，落在自适应图标中央 66.7% 的安全区内。

		     ⚠ 改这个 Color（或换图）之后，**本地构建要先删掉 obj/<配置>/<tfm>/resizetizer 再构建**。
		     那个目录会缓存生成的背景层，只改 Color 不会让它失效：实测过一次，前台已经换成新图了，
		     背景却还是 MAUI 默认的紫 #512BD4。CI 是干净环境，不受影响。 -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" Color="#0C1C34" />

		<!-- Splash Screen：同一图案，底色取 logo 自己的藏青，图案居中；BaseSize 是这个图案在启动图里的基准尺寸。 -->
		<MauiSplashScreen Include="Resources\Splash\splash.png" Color="#0C1C34" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\DailyMusings.Client.Core\DailyMusings.Client.Core.csproj" />
	</ItemGroup>

</Project>
