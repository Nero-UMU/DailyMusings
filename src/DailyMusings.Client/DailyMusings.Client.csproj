<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android is the only target. The desktop client was dropped from the project's direction: everything
		     shared lives in DailyMusings.Client.Core, and the platform layer is now a single implementation. -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>

		<!-- Directory.Build.props applies a net10.0 default to every project. It is evaluated before this project
		     body, so it cannot see TargetFrameworks and must be cleared here or the build would try a bare net10.0
		     inner target. -->
		<TargetFramework></TargetFramework>

		<OutputType>Exe</OutputType>
		<RootNamespace>DailyMusings.Client</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>

		<!-- The MAUI template's package versions ride $(MauiVersion), which is not defined when the central package
		     file is evaluated, so this project manages its own versions. -->
		<ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>

		<!-- XAML and platform analyzers are noisier than the server-side projects and cannot be fixed here. -->
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>

		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>每日随想</ApplicationTitle>
		<ApplicationId>dev.dailymusings.client</ApplicationId>

		<!-- 本地开发用的默认值。发布时由 release.yml 从 tag 推导并覆盖：
		     ApplicationDisplayVersion=1.0.3、ApplicationVersion=10003（major*10000+minor*100+patch）。
		     versionCode 必须随每次发布**单调递增**，否则手机会拒绝覆盖安装（表现为「应用未安装」）——
		     这正是 1.0.3 那一轮修掉的问题：此前它一直写死 1，所有发布的 APK 都装不上已装的旧版。 -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Android 8.0 / API 26, per decision A.11: the runtime permission model is settled by then and it avoids
		     the legacy storage-permission branches that older targets drag in. -->
		<SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon：单张位图（原图无 alpha 通道，白底），Color 是自适应图标的底色。取白而不是品牌紫，
		     否则四角会露出一圈紫色边框。 -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" Color="#FFFFFF" />

		<!-- Splash Screen：同一图案，白底配白底色，图案居中；BaseSize 是这个图案在启动图里的基准尺寸。 -->
		<MauiSplashScreen Include="Resources\Splash\splash.png" Color="#FFFFFF" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\DailyMusings.Client.Core\DailyMusings.Client.Core.csproj" />
	</ItemGroup>

</Project>
