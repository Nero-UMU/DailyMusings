<?xml version="1.0" encoding="utf-8"?>
<!--
  The packaged Windows client (docs/开发指导.md §18).

  NOT A DELIVERABLE (decision A.16): Windows ships as the unpackaged, self-contained zip — unzip and run, no
  installer, no certificate, no administrator. This manifest stays in the repository because the parameters that
  make an MSIX build are recorded in docs/发布校验值.md and the packaging path is only one command away, but it is
  not built, signed or re-verified per release. The reason is the cost of the self-signed signature: every machine
  would first have to import the certificate into its *machine* stores with administrator rights, which is a poor
  trade for a self-hosted personal tool.

  The shape follows the .NET MAUI template closely, because MakeAppx validates this against the appx schema and a
  manifest that merely looks right is rejected. `runFullTrust` is a *restricted* capability: it has to sit in
  `Capabilities` with the rescap prefix, its namespace has to be listed in `IgnorableNamespaces`, and the
  microphone is requested separately as a device capability — without which MediaCapture refuses to start and
  recording fails on a machine that has a perfectly good microphone. That is the same silent failure the Android
  side hit with RECORD_AUDIO.

  The image attributes say `$placeholder$.png`, and they have to keep saying it. That token is what
  `Microsoft.Maui.Resizetizer.GeneratePackageAppxManifest` replaces with the names of the icon and splash images
  the build actually generated (`appiconStoreLogo.png`, `splashSplashScreen.png`, …). Writing the older
  `Assets\Square150x150Logo.png` paths here — which look right, and are what pre-MAUI templates used — leaves them
  untouched, so the package ships a manifest pointing at files that are not inside it. Found by installing the
  MSIX, the one step that had never been taken: `Add-AppxPackage` refused the package with 0x80070003
  「找不到初始屏幕图像 [SplashScreen.png]」, which is exactly this mismatch.
-->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap mp rescap">

  <Identity Name="dev.dailymusings.client" Publisher="CN=DailyMusings" Version="1.0.0.0" />

  <Properties>
    <DisplayName>每日随想</DisplayName>
    <PublisherDisplayName>DailyMusings</PublisherDisplayName>
    <Logo>$placeholder$.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
      <uap:VisualElements
          DisplayName="每日随想"
          Description="捕捉想法，成文于每日"
          Square150x150Logo="$placeholder$.png"
          Square44x44Logo="$placeholder$.png"
          BackgroundColor="transparent">
        <uap:DefaultTile Wide310x150Logo="$placeholder$.png" />
        <uap:SplashScreen Image="$placeholder$.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <DeviceCapability Name="microphone" />
  </Capabilities>
</Package>
