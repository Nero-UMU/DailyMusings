<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DailyMusings.Client.Pages.TodayPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:DailyMusings.Client.Pages"
    Title="今日">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <!-- §10.3: shown for as long as an insecure connection is configured, on every screen. -->
            <Border
                x:Name="InsecureBanner"
                IsVisible="False"
                Stroke="#B42318"
                StrokeThickness="1"
                BackgroundColor="#FFEBE9"
                Padding="12">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Label
                    TextColor="#7A271A"
                    FontSize="13"
                    Text="当前连接未加密（HTTP）。密码、设备令牌、录音和文章都可能被同一网络中的他人截获。请优先使用 HTTPS、局域网或 VPN。此提示只说明风险，不代表连接已经安全。" />
            </Border>

            <!-- The one prominent control on the screen (§9.1). -->
            <Button
                x:Name="RecordButton"
                Text="开始录音"
                FontSize="20"
                HeightRequest="96"
                BackgroundColor="#512BD4"
                TextColor="White"
                Clicked="OnRecordClicked" />

            <Label
                x:Name="RecordStatus"
                HorizontalTextAlignment="Center"
                TextColor="#656D76"
                Text="按住想法，说一句话。" />

            <BoxView HeightRequest="1" Color="#E1E4E8" />

            <Label Text="直接写下来" FontAttributes="Bold" />
            <Editor
                x:Name="TextEditor"
                Placeholder="随手记一句…"
                AutoSize="TextChanges"
                HeightRequest="96" />
            <Button Text="保存这句" Clicked="OnSaveTextClicked" />

            <BoxView HeightRequest="1" Color="#E1E4E8" />

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="待上传" FontAttributes="Bold" VerticalOptions="Center" />
                <Button
                    Grid.Column="1"
                    Text="立即同步"
                    Padding="12,4"
                    Clicked="OnSyncClicked" />
            </Grid>

            <Label
                x:Name="SyncStatus"
                TextColor="#656D76"
                FontSize="13" />

            <CollectionView x:Name="PendingList" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="没有待上传的内容。" TextColor="#656D76" FontSize="13" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="pages:PendingRow">
                        <Border Padding="10" Margin="0,4" Stroke="#E1E4E8" StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <Label Text="{Binding Title}" FontAttributes="Bold" />
                                <Label
                                    Grid.Row="1"
                                    Text="{Binding Detail}"
                                    FontSize="12"
                                    TextColor="#B42318" />
                                <HorizontalStackLayout Grid.Column="1" Grid.RowSpan="2" Spacing="6">
                                    <Button
                                        Text="重试"
                                        IsVisible="{Binding CanRetry}"
                                        Padding="10,2"
                                        FontSize="12"
                                        Clicked="OnRetryClicked"
                                        CommandParameter="{Binding Id}" />
                                    <Button
                                        Text="删除"
                                        Padding="10,2"
                                        FontSize="12"
                                        Clicked="OnDiscardClicked"
                                        CommandParameter="{Binding Id}" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <BoxView HeightRequest="1" Color="#E1E4E8" />

            <Label Text="今天的输入" FontAttributes="Bold" />

            <Label
                x:Name="TodayStatus"
                TextColor="#656D76"
                FontSize="13" />

            <CollectionView x:Name="TodayList" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="pages:TodayRow">
                        <Border Padding="10" Margin="0,4" Stroke="#E1E4E8" StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Title}" />
                                <Label Text="{Binding Status}" FontSize="12" TextColor="#656D76" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
