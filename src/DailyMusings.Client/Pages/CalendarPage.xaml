<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DailyMusings.Client.Pages.CalendarPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:DailyMusings.Client.Pages"
    Shell.NavBarIsVisible="False">

    <!--
        §3.3 of the phone spec: the recordings and notes kept on this device, newest first, with a filter and a
        detail sheet. The list is the device's own archive — the server is never consulted to draw it, so the page
        works with the server gone.
    -->
    <Grid>

        <ScrollView>
            <VerticalStackLayout
                Padding="20,24,20,36"
                Spacing="16"
                HorizontalOptions="Center"
                MaximumWidthRequest="560">

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <Label Text="日历" Style="{StaticResource TitleLabel}" />
                        <Label x:Name="SubtitleLabel" Style="{StaticResource CaptionLabel}" />
                    </VerticalStackLayout>
                    <Button
                        x:Name="FilterButton"
                        Grid.Column="1"
                        Style="{StaticResource GhostButton}"
                        Text="筛选"
                        VerticalOptions="Center"
                        Clicked="OnFilterClicked" />
                </Grid>

                <Label x:Name="StatusLabel" Style="{StaticResource CaptionLabel}" />

                <CollectionView x:Name="RecordList" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="pages:CalendarRow">
                            <Border Style="{StaticResource Card}" Padding="14" Margin="0,5">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRowTapped" CommandParameter="{Binding Id}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Label
                                        Text="{Binding Glyph}"
                                        FontSize="18"
                                        VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                        <Label
                                            Text="{Binding Time}"
                                            FontAttributes="Bold"
                                            FontSize="15" />
                                        <Label
                                            Text="{Binding Summary}"
                                            Style="{StaticResource CaptionLabel}"
                                            MaxLines="2"
                                            LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                    <Label
                                        Grid.Column="2"
                                        Text="{Binding State}"
                                        TextColor="{Binding StateColor}"
                                        FontSize="12"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- The detail sheet. It sits outside the ScrollView so it covers the whole screen rather than scrolling with it. -->
        <Grid x:Name="DetailOverlay" IsVisible="False" BackgroundColor="#D9000000">
            <Border
                Style="{StaticResource Card}"
                Margin="16"
                Padding="18"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                MaximumWidthRequest="560">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label
                            x:Name="DetailTitle"
                            FontAttributes="Bold"
                            FontSize="16"
                            VerticalOptions="Center" />
                        <Button
                            Grid.Column="1"
                            Text="✕"
                            Style="{StaticResource GhostButton}"
                            WidthRequest="48"
                            Clicked="OnCloseDetailClicked" />
                    </Grid>

                    <VerticalStackLayout x:Name="DetailPlayback" Spacing="6" IsVisible="False">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Button
                                x:Name="DetailPlayButton"
                                Text="▶"
                                Style="{StaticResource GhostButton}"
                                WidthRequest="58"
                                Clicked="OnDetailPlayPauseClicked" />
                            <Slider
                                x:Name="DetailSlider"
                                Grid.Column="1"
                                Minimum="0"
                                Maximum="1"
                                Value="0"
                                VerticalOptions="Center"
                                DragStarted="OnDetailSeekStarted"
                                DragCompleted="OnDetailSeekCompleted"
                                ValueChanged="OnDetailSliderValueChanged" />
                            <Label
                                x:Name="DetailPosition"
                                Grid.Column="2"
                                Style="{StaticResource CaptionLabel}"
                                VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>

                    <ScrollView HeightRequest="300">
                        <Label x:Name="DetailText" Style="{StaticResource TranscriptLabel}" />
                    </ScrollView>

                    <Button
                        x:Name="DetailDeleteButton"
                        Style="{StaticResource DangerButton}"
                        Text="删除这段录音"
                        Clicked="OnDeleteDetailClicked" />
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>

</ContentPage>
