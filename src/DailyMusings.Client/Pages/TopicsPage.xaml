<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DailyMusings.Client.Pages.TopicsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:DailyMusings.Client.Pages"
    Title="主题">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <!-- §10.3: shown for as long as an insecure connection is configured, on every screen. -->
            <Border
                x:Name="InsecureBanner"
                IsVisible="False"
                Stroke="#B42318"
                StrokeThickness="1"
                BackgroundColor="#FFEBE9"
                Padding="12">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Label
                    TextColor="#7A271A"
                    FontSize="13"
                    Text="当前连接未加密（HTTP）。密码、设备令牌、录音和文章都可能被同一网络中的他人截获。请优先使用 HTTPS、局域网或 VPN。此提示只说明风险，不代表连接已经安全。" />
            </Border>

            <Label Text="新增主题" FontAttributes="Bold" />
            <Entry x:Name="NewTopicName" Placeholder="例如：晨跑" />
            <Button Text="添加" Clicked="OnCreateClicked" />

            <BoxView HeightRequest="1" Color="#E1E4E8" />

            <Label Text="已有主题" FontAttributes="Bold" />
            <Label
                x:Name="TopicStatus"
                FontSize="12"
                TextColor="#656D76" />

            <CollectionView x:Name="TopicList" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="pages:TopicRow">
                        <Border Padding="10" Margin="0,4" Stroke="#E1E4E8" StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Name}" FontAttributes="Bold" />
                                <Label Text="{Binding Detail}" FontSize="12" TextColor="#656D76" />
                                <HorizontalStackLayout Spacing="8">
                                    <Button
                                        Text="重命名"
                                        IsVisible="{Binding CanRename}"
                                        Padding="10,2"
                                        FontSize="12"
                                        Clicked="OnRenameClicked"
                                        CommandParameter="{Binding Id}" />
                                    <Button
                                        Text="合并到…"
                                        Padding="10,2"
                                        FontSize="12"
                                        Clicked="OnMergeClicked"
                                        CommandParameter="{Binding Id}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label x:Name="ActionStatus" FontSize="13" TextColor="#656D76" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
