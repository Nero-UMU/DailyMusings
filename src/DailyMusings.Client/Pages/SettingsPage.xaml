<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DailyMusings.Client.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout
            Padding="20,24,20,36"
            Spacing="18"
            HorizontalOptions="Center"
            MaximumWidthRequest="560">

            <Label Text="设置" Style="{StaticResource TitleLabel}" />

            <Label Text="服务器" Style="{StaticResource SectionLabel}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Border Style="{StaticResource InputWell}">
                        <Entry x:Name="ServerUrlEntry" BackgroundColor="{StaticResource Transparent}"
                               Placeholder="http://192.168.1.10:18321" Keyboard="Url" />
                    </Border>
                    <Label
                        Style="{StaticResource CaptionLabel}"
                        Text="服务端地址，含端口，例如 http://192.168.1.10:18321。" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="保存地址" Clicked="OnSaveServerClicked" />
                        <Button
                            Grid.Column="1"
                            Text="测试连接"
                            Style="{StaticResource GhostButton}"
                            Clicked="OnTestConnectionClicked" />
                    </Grid>
                    <Label x:Name="ServerStatus" Style="{StaticResource CaptionLabel}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="设备配对" Style="{StaticResource SectionLabel}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label x:Name="PairingState" Style="{StaticResource BodyLabel}" />
                    <Border Style="{StaticResource InputWell}">
                        <Entry x:Name="PairingCodeEntry" BackgroundColor="{StaticResource Transparent}"
                               Placeholder="在管理页生成配对码后填到这里" MaxLength="32" />
                    </Border>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="配对" Clicked="OnPairClicked" />
                        <Button
                            Grid.Column="1"
                            Text="解除配对"
                            Style="{StaticResource GhostButton}"
                            Clicked="OnUnpairClicked" />
                    </Grid>
                    <Label x:Name="PairingStatus" Style="{StaticResource CaptionLabel}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="本机记录" Style="{StaticResource SectionLabel}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label
                        Style="{StaticResource CaptionLabel}"
                        Text="清空后无法恢复本机记录。" />
                    <Label x:Name="LocalUsage" Style="{StaticResource BodyLabel}" />
                    <Button
                        x:Name="ClearLocalButton"
                        Text="清空本机记录"
                        Style="{StaticResource DangerButton}"
                        Clicked="OnClearLocalClicked" />
                    <Label x:Name="LocalStatus" Style="{StaticResource CaptionLabel}" />
                </VerticalStackLayout>
            </Border>

            <!-- §8.1: the client may see the model names and whether they are on, and nothing more. -->
            <VerticalStackLayout x:Name="ModelSection" Spacing="8" IsVisible="False">
                <Label Text="实例上的模型" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label x:Name="ModelStatus" Style="{StaticResource CaptionLabel}" />
                        <Button
                            Text="刷新"
                            Style="{StaticResource GhostButton}"
                            HorizontalOptions="Start"
                            Clicked="OnRefreshModelsClicked" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <Label Text="本机信息" Style="{StaticResource SectionLabel}" />
            <Label x:Name="DeviceInfoLabel" Style="{StaticResource CaptionLabel}" />

            <Label
                Style="{StaticResource CaptionLabel}"
                Text="本机保存服务器地址和设备令牌。" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
