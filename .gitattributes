# Line endings.
#
# The product is built and deployed on Linux (Docker), so text files are stored with LF regardless of the
# contributor's platform. Without this, a Windows checkout commits CRLF and every subsequent Linux build sees
# the whole file as modified.
* text=auto eol=lf

# Binary assets must never be normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.dll binary
*.so binary
*.db binary
*.nupkg binary
